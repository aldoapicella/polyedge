[Unit]
Description=Manual-only OCI qset-v6 profitability processor
Requires=network-online.target polyedge-network.service polyedge-federated-token@shadow-qset-v6-processor.service
After=network-online.target polyedge-network.service polyedge-federated-token@shadow-qset-v6-processor.service
RequiresMountsFor=/srv/polyedge-ring /run/polyedge-federated-shadow-qset-v6-processor
ConditionPathExists=/etc/polyedge/ENABLE_QSET_V6_PROCESSOR_MANUAL

[Service]
Type=oneshot
EnvironmentFile=/etc/polyedge/jobs/qset-v6-processor.env
ExecStartPre=/usr/bin/rm -f /etc/polyedge/ENABLE_QSET_V6_PROCESSOR_MANUAL
ExecStartPre=/usr/bin/sync -f /etc/polyedge
ExecStart=/usr/local/libexec/polyedge-run-job qset-v6-processor
TimeoutStartSec=5h
CPUQuota=400%
MemoryMax=8G
TasksMax=1024
UMask=0027
