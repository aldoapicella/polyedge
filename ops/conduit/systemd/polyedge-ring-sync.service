[Unit]
Description=Seal and upload PolyEdge recorder segments
After=network-online.target polyedge-network.service
Wants=network-online.target
Requires=polyedge-network.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/polyedge-ring-sync.lock /usr/local/libexec/polyedge-ring-sync
CPUQuota=50%
MemoryMax=10G
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
