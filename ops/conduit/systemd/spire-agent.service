[Unit]
Description=SPIRE Agent for PolyEdge workload identities
After=spire-server.service
Requires=spire-server.service

[Service]
User=root
Group=spire-workload
StateDirectory=spire-agent
StateDirectoryMode=0700
RuntimeDirectory=spire
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/opt/spire/bin/spire-agent run -config /etc/spire/agent.conf
ExecStartPost=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/spire/agent.sock ] && exec /usr/bin/chmod 0660 /run/spire/agent.sock; /usr/bin/sleep 0.1; done; exit 1'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
