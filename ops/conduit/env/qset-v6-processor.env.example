# Negative trust boundary: this lane must receive no funded, SB, KV, or client-secret binding.
FUNDED_DIRECT_SERVICE_BUS_ENABLED=false
FUNDED_DIRECT_SERVICE_BUS_NAMESPACE=
FUNDED_DIRECT_SERVICE_BUS_QUEUE=
