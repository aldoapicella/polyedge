POLYEDGE_QSET_V6_DAY1_INVENTORY_SHA256=
POLYEDGE_QSET_V6_DAY2_RECEIPT_SHA256=
POLYEDGE_QSET_V6_DAY2_INVENTORY_SHA256=

SHADOW_CAMPAIGN_ID=campaign-2026-09-01-qset-v6
SHADOW_CAMPAIGN_START=2026-09-01
SHADOW_CAMPAIGN_PREFIX=shadow-events/campaign-2026-09-01-qset-v6
SHADOW_CAMPAIGN_REPORT_ROOT=reports/research/shadow/campaigns/campaign-2026-09-01-qset-v6
SHADOW_CORRECTION_ROOT=reports/research/shadow/campaigns/campaign-2026-09-01-qset-v6/corrections
SHADOW_CAMPAIGN_CONTRACT=research/configs/profitability_gate_v3_2026-09-01_qset_v6.yaml
SHADOW_EVIDENCE_VERSION=protocol-v3-qset-v6
SHADOW_REPORT_DATE=2026-09-01
SHADOW_CASCADE_THROUGH=2026-09-01
SHADOW_PROJECTED_DATA_START=2026-09-01
SHADOW_SOURCE_CONTAINER_NAME=polyedge-shadow-qset-v6-events
AZURE_STORAGE_CONTAINER_NAME=polyedge-research-qset-v6
QSET_V6_CONTROL_CONTAINER_NAME=polyedge-qset-v6-control
POLYEDGE_CAMPAIGN_LEASE_BLOB=data/research/shadow/campaign-2026-09-01-qset-v6/control/replay.lock
SHADOW_EXECUTION_MODEL_BLOB_NAME=reports/research/venue-probe/models/conservative-execution-prior-v1-91f29155d09f1a51f3354132befcbbb25d3f96b88c9a8a819f2304f4a7a28ed4.json
SHADOW_EXECUTION_MODEL_SHA256=sha256:91f29155d09f1a51f3354132befcbbb25d3f96b88c9a8a819f2304f4a7a28ed4

SHADOW_CODE_FREEZE_FINALIZED=
