# Install as /etc/polyedge/jobs/qset-v6-processor.env, root:root 0640.
# Leave every receipt/image/freeze blank until copied from the final reviewed artifacts.
APP_NAME=polyedge-qset-v6-processor
EXECUTION_MODE=paper
ALLOW_LIVE=false
RUN_BOT_ON_STARTUP=false
ENABLE_TAKER_ORDERS=false
POLYEDGE_QSET_V6_PROCESSOR_IMAGE=
POLYEDGE_QSET_V6_PROCESSOR_GIT_SHA=
POLYEDGE_QSET_V6_SOURCE_FREEZE_RECEIPT_SHA256=
