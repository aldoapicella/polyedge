APP_NAME=polyedge
RUNTIME_ROLE=primary
EXECUTION_MODE=paper
ALLOW_LIVE=false
RUN_BOT_ON_STARTUP=true
REQUIRE_API_AUTH=true
ENABLE_TAKER_ORDERS=false
ALLOW_EMERGENCY_ACCOUNT_CANCEL=false
PAPER_MAKER_FILL_POLICY=touch_after_quote_was_live
PAPER_ORDER_LIVE_AFTER_MS=250
LOCAL_JSONL_RECORDER_ENABLED=true
RECORDER_PATH=/srv/polyedge-ring/segments
RECORDER_SEGMENT_SECONDS=600
# The shared RTDS socket can freeze while ping/pong stays live; reconnect quickly.
RTDS_CHAINLINK_WATCHDOG_SECONDS=30
POLYMARKET_MARKET_WATCHDOG_SECONDS=60

# Fill these only after the no-delete container/table roles are assigned.
# AZURE_STORAGE_ACCOUNT_NAME=REPLACE_STORAGE_ACCOUNT
AZURE_STORAGE_CONTAINER_NAME=bot-events
AZURE_STORAGE_TABLE_NAME=BotEventIndex
AZURE_CHART_TABLE_NAME=BotChartSeries
AZURE_MARKET_TABLE_NAME=BotMarketCatalog
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_FEDERATED_TOKEN_FILE=/run/credentials/azure-federated-token
# Client-secret fallback only: remove AZURE_FEDERATED_TOKEN_FILE and set
# AZURE_CLIENT_SECRET_FILE=/run/credentials/azure-client-secret.
AZURE_CHART_PERSIST_INTERVAL_MS=60000
