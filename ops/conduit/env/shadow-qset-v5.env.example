APP_NAME=polyedge-shadow-qset-v5
RUNTIME_ROLE=profitability_shadow
EXECUTION_MODE=paper
ALLOW_LIVE=false
RUN_BOT_ON_STARTUP=true
REQUIRE_API_AUTH=false
ENABLE_TAKER_ORDERS=false
ALLOW_EMERGENCY_ACCOUNT_CANCEL=false
PAPER_MAKER_FILL_POLICY=none
PAPER_ORDER_LIVE_AFTER_MS=250
ADAPTIVE_REGIME_ENABLED=true
ADAPTIVE_REGIME_MODE=dynamic_quote_style
BASE_ORDER_SIZE=1
MAX_DAILY_LOSS=1
MAX_OPEN_ORDERS=1
MAX_ORDER_SIZE=1
MAX_POSITION_PER_MARKET=1
MAX_TOTAL_POSITION=1
COMPACT_SHADOW_RECORDING=true
SHADOW_BOOK_SAMPLE_MS=1000
ENABLE_DIRECT_BINANCE_BOOK_TICKER=false
TARGET_ASSET=BTC
TARGET_ASSET_NAME=Bitcoin
TARGET_BINANCE_SYMBOL=btcusdt
TARGET_CHAINLINK_SYMBOL=btc/usd
TARGET_COINBASE_PRODUCT_ID=BTC-USD
TARGET_HORIZON=15m
RUST_LOG=warn,polyedge_api::runtime=info
LOCAL_JSONL_RECORDER_ENABLED=false

# Populate every blank only from the final, reviewed qset-v5 freeze manifest. SHADOW_CODE_FREEZE_MANIFEST must be a fully expanded literal azure://ACCOUNT/polyedge-qset-v5-control/RELATIVE_PATH; do not leave variables in that value.
SHADOW_CAMPAIGN_ID=campaign-2026-08-26-qset-v5
SHADOW_EVIDENCE_VERSION=protocol-v3-qset-v5
SHADOW_CODE_FREEZE_FINALIZED=
SHADOW_CODE_FREEZE_SHA256=
EXECUTION_FREEZE_ARTIFACT_PATH=
EXECUTION_FREEZE_SHA256=
SHADOW_CODE_FREEZE_MANIFEST=
# Exact immutable writer binding required by the qset-v5 boundary guard.
POLYEDGE_QSET_V5_WRITER_IMAGE=
POLYEDGE_QSET_V5_WRITER_GIT_SHA=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_FEDERATED_TOKEN_FILE=/run/credentials/azure-federated-token
AZURE_TOKEN_CREDENTIALS=WorkloadIdentityCredential
AZURE_STORAGE_ACCOUNT_NAME=
# Raw writes stay physically separate from v1/v2 and from v3 research/control.
AZURE_STORAGE_CONTAINER_NAME=polyedge-shadow-qset-v5-events
AZURE_RESEARCH_STORAGE_CONTAINER_NAME=polyedge-research-qset-v5
POLYEDGE_QSET_V5_CONTROL_CONTAINER_NAME=polyedge-qset-v5-control
AZURE_STORAGE_TABLE_NAME=ShadowQsetV5EventIndex
AZURE_CHART_TABLE_NAME=ShadowQsetV5ChartSeries
AZURE_MARKET_TABLE_NAME=ShadowQsetV5MarketCatalog
AZURE_EVENT_INDEX_TYPES=runtime_provenance,market,market_start_price,paper_settlement,fair_value,decision,execution_report,feed_error,reference
# The process reads this clock on each write; it switches at the exact instant
# without a service restart. Both locations are private v3 prefixes.
AZURE_EVENT_BLOB_PREFIX=shadow-events/preflight/campaign-2026-08-26-qset-v5
AZURE_EVENT_BLOB_PREFIX_AFTER_CUTOVER=shadow-events/campaign-2026-08-26-qset-v5
AZURE_EVENT_BLOB_PREFIX_CUTOVER_UTC=2026-08-26T00:00:00Z
AZURE_FUNDED_STORAGE_CONTAINER_NAME=polyedge-funded-evidence
AZURE_MODEL_STORAGE_CONTAINER_NAME=polyedge-models

PUBLISH_STRATEGY_CANARY_INTENTS=true
STRATEGY_INTENT_OPERATOR_DIRECT=true
STRATEGY_INTENT_POINTER_ONLY_PREFLIGHT=true
FUNDED_DIRECT_SERVICE_BUS_ENABLED=false
FUNDED_DIRECT_SERVICE_BUS_NAMESPACE=
FUNDED_DIRECT_SERVICE_BUS_QUEUE=
STRATEGY_CANARY_EXECUTION_MODEL_BLOB_URI=azure://stpolyedge6urdjr5nmwx7w/polyedge-research-qset-v5/reports/research/venue-probe/models/conservative-execution-prior-v1-91f29155d09f1a51f3354132befcbbb25d3f96b88c9a8a819f2304f4a7a28ed4.json
STRATEGY_CANARY_EXECUTION_MODEL_SHA256=sha256:91f29155d09f1a51f3354132befcbbb25d3f96b88c9a8a819f2304f4a7a28ed4
STRATEGY_CANARY_INTENT_PREFIX=control/strategy-canary/intents/campaign-2026-08-26-qset-v5/intents
STRATEGY_CANARY_REQUIRED_FILL_MODEL_VERSION=conservative-execution-prior-v1
