#!/bin/sh
set -eu
umask 027

[ "$(id -u)" -eq 0 ] || { echo 'polyedge-ring-quarantine must run as root' >&2; exit 77; }
[ "$#" -eq 3 ] || {
  echo 'usage: polyedge-ring-quarantine RECEIPT_ID FORMAL_BOUNDARY_EPOCH APPROVAL_REFERENCE' >&2
  exit 64
}
receipt_id=$1
formal_boundary=$2
approval_reference=$3
printf '%s' "$receipt_id" | grep -Eq '^[0-9a-f]{64}$' || { echo 'invalid receipt ID' >&2; exit 64; }
printf '%s' "$formal_boundary" | grep -Eq '^[1-9][0-9]*$' && [ "$((formal_boundary % 600))" -eq 0 ] || {
  echo 'formal boundary must be a canonical 10-minute epoch' >&2
  exit 64
}
[ -n "$approval_reference" ] || { echo 'approval reference is required' >&2; exit 64; }

env_file=${POLYEDGE_RING_ENV_FILE:-/etc/polyedge/ring.env}
test -r "$env_file" || { echo "missing $env_file" >&2; exit 64; }
set -a
. "$env_file"
set +a

root=${POLYEDGE_RING_ROOT:-/srv/polyedge-ring}
[ ! -L "$root" ] && [ -d "$root" ] || { echo "ring root is not a regular directory: $root" >&2; exit 1; }
root_requested=$root
root=$(realpath -e -- "$root") || exit 1
[ "$root_requested" = "$root" ] || { echo "ring root path contains a symlink or is non-canonical: $root_requested" >&2; exit 1; }
mountpoint -q "$root" || { echo "$root is not a mount point" >&2; exit 1; }
segments=$root/segments
archive=$root/archive
quarantine_parent=$root/quarantine
quarantine=$quarantine_parent/recorder-sequence-proof-v1
resolved_quarantine=$quarantine_parent/resolved-recorder-sequence-proof-v1
for ring_dir in "$segments" "$archive" "$quarantine_parent" "$quarantine" "$resolved_quarantine"; do
  [ ! -L "$ring_dir" ] && [ -d "$ring_dir" ] || { echo "unsafe or missing ring directory: $ring_dir" >&2; exit 1; }
  ring_dir_real=$(realpath -e -- "$ring_dir") || exit 1
  case "$ring_dir_real" in "$root"/*) ;; *) echo "ring directory escapes mount root: $ring_dir" >&2; exit 1 ;; esac
done
: "${POLYEDGE_RING_IMAGE:?set an immutable POLYEDGE_RING_IMAGE}"
: "${AZURE_STORAGE_ACCOUNT_NAME:?set AZURE_STORAGE_ACCOUNT_NAME}"
: "${AZURE_STORAGE_CONTAINER_NAME:?set AZURE_STORAGE_CONTAINER_NAME}"
printf '%s' "$POLYEDGE_RING_IMAGE" | grep -Eq '^ghcr\.io/[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$' || {
  echo 'POLYEDGE_RING_IMAGE must be an immutable GHCR digest' >&2
  exit 64
}
[ "${POLYEDGE_AZURE_ARC_IDENTITY:-}" = 1 ] || {
  echo 'historical quarantine resolution requires Azure Arc managed identity' >&2
  exit 64
}

exec 9>/run/polyedge-ring-sync.lock
/usr/bin/flock -n 9 || { echo 'ring sync lock is busy' >&2; exit 75; }
set -- /usr/bin/podman run --rm --pull=never --log-driver=journald --name polyedge-ring-quarantine \
  --cpus 0.5 --memory 2g --pids-limit 256 \
  --read-only --cap-drop=all --cap-add=DAC_OVERRIDE \
  --env AZURE_STORAGE_ACCOUNT_NAME \
  --env AZURE_STORAGE_CONTAINER_NAME \
  -v "$segments:/srv/polyedge-ring/segments:ro,Z" \
  -v "$archive:/srv/polyedge-ring/archive:ro,Z" \
  -v "$quarantine_parent:/srv/polyedge-ring/quarantine:Z"

test -d /var/opt/azcmagent/tokens || { echo 'Azure Arc identity token directory is unavailable' >&2; exit 1; }
himds_gid=$(getent group himds | cut -d: -f3)
printf '%s' "$himds_gid" | grep -Eq '^[0-9]+$' || { echo 'Azure Arc himds group is unavailable' >&2; exit 1; }
set -- "$@" \
  --network host \
  --group-add "$himds_gid" \
  --env IDENTITY_ENDPOINT=http://127.0.0.1:40342/metadata/identity/oauth2/token \
  --env IMDS_ENDPOINT=http://127.0.0.1:40342 \
  -v /var/opt/azcmagent/tokens:/var/opt/azcmagent/tokens:ro

/usr/bin/timeout --signal=TERM --kill-after=60s 3h \
  "$@" "$POLYEDGE_RING_IMAGE" polyedge-rs ring-quarantine-resolve \
  --root /srv/polyedge-ring \
  --receipt-id "$receipt_id" \
  --formal-boundary-epoch "$formal_boundary" \
  --approval-reference "$approval_reference"
