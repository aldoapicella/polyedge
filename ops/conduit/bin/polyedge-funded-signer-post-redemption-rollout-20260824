#!/usr/bin/env bash
set -euo pipefail
umask 027
readonly run=${POLYEDGE_POST_REDEMPTION_RUN_ID:-venue-redemption-20260824152948770-7560c2ca}
readonly tx=${POLYEDGE_POST_REDEMPTION_TRANSACTION_HASH:-0x73c2166244330061bb128d4bfda40f1034cad8a45fb80428a5eb0956ed003007}
readonly condition=${POLYEDGE_POST_REDEMPTION_CONDITION_ID:-0x20e08e26ca31815123ec8240321ba1d8955a00e829ae40b40e5c0de1d0ab07d6}
readonly settlement_blob=${POLYEDGE_POST_REDEMPTION_SETTLEMENT_BLOB:-reports/funded/dynamic-quote/sessions/dynamic-quote-funded-2026-08-13-v10/internal-settlements/4cdbc30c82396fd99ffb0b376d771f048c2e8e4d27ca4f370f3c349fc00605a3.json}
readonly fresh_after=${POLYEDGE_POST_REDEMPTION_FRESH_AFTER:-2026-08-24T15:29:48Z}
readonly liquid_before=${POLYEDGE_POST_REDEMPTION_LIQUID_BEFORE:-29.908437}
readonly liquid_after=${POLYEDGE_POST_REDEMPTION_LIQUID_AFTER:-29.928437}
readonly payout=${POLYEDGE_POST_REDEMPTION_PAYOUT:-0.02}
readonly min_disk=16106127360
test "$#" -eq 0
: "$POLYEDGE_POST_REDEMPTION_LIVE_SUMMARY" "$POLYEDGE_POST_REDEMPTION_DRY_RUN" "$POLYEDGE_POST_REDEMPTION_SETTLEMENT" "$POLYEDGE_POST_REDEMPTION_ATTESTATION_DIR"
live=$POLYEDGE_POST_REDEMPTION_LIVE_SUMMARY; dry=$POLYEDGE_POST_REDEMPTION_DRY_RUN; settlement=$POLYEDGE_POST_REDEMPTION_SETTLEMENT; out=$POLYEDGE_POST_REDEMPTION_ATTESTATION_DIR
systemctl=/usr/bin/systemctl; podman=/usr/bin/podman; journalctl=/usr/bin/journalctl; runuser=/usr/sbin/runuser; az=/usr/bin/az; guard=/usr/local/libexec/polyedge-boot-disk-guard; uid=0; gid=0; lock=/run/polyedge/utility.lock
if [ "${POLYEDGE_TEST_ALLOW_UNPRIVILEGED:-0}" = 1 ]; then systemctl=$POLYEDGE_TEST_SYSTEMCTL; podman=$POLYEDGE_TEST_PODMAN; journalctl=$POLYEDGE_TEST_JOURNALCTL; runuser=$POLYEDGE_TEST_RUNUSER; az=$POLYEDGE_TEST_AZ; guard=$POLYEDGE_TEST_DISK_GUARD; uid=$POLYEDGE_TEST_UID; gid=$POLYEDGE_TEST_GID; lock=$POLYEDGE_TEST_LOCK_FILE; else test "$(/usr/bin/id -u)" -eq 0; fi
sha(){ /usr/bin/sha256sum "$1"|/usr/bin/cut -d" " -f1; }
secure(){ local u g m l s; test ! -L "$1" -a -f "$1"; read -r u g m l s < <(/usr/bin/stat -c "%u %g %a %h %s" "$1"); test "$u:$g:$m:$l" = "$uid:$gid:$2:1" -a "$s" -gt 0 -a "$s" -le 65536; }
queue(){ "$runuser" -u ubuntu -- "$az" servicebus queue show --subscription 73783c0c-5a53-4f9b-b244-6f64e813814c --resource-group rg-polyedge-dev --namespace-name sb-polyedge-funded-cl-6urdjr5nmwx7w --name funded-dynamic-quote-intents --only-show-errors -o json|/usr/bin/jq -ce 'if .status=="Active" and .countDetails.activeMessageCount==0 and .countDetails.scheduledMessageCount==0 and (.countDetails.deadLetterMessageCount|type=="number" and .>=0) then {status:.status,activeMessageCount:.countDetails.activeMessageCount,scheduledMessageCount:.countDetails.scheduledMessageCount,deadLetterMessageCount:.countDetails.deadLetterMessageCount} else error("queue is not a current zero-active DLQ snapshot") end'; }
heartbeat(){ local i c n; i=$("$systemctl" show polyedge-funded-signer.service -p InvocationID --value); c=$("$podman" inspect --format "{{.Id}}" polyedge-funded-signer); n=$(/usr/bin/date -u +%s); "$journalctl" -u polyedge-funded-signer.service -n 500 -o json --no-pager|/usr/bin/jq -Rse --arg i "$i" --arg c "$c" --argjson n "$n" '[split("\n")[]|fromjson?|select(type=="object")|. as $r|($r.MESSAGE|fromjson?) as $e|select($e|type=="object")|{t:(($r.__REALTIME_TIMESTAMP|tonumber)/1000000),i:($r._SYSTEMD_INVOCATION_ID//""),c:($r.CONTAINER_ID_FULL//""),e:$e}] as $x|[$x[]|select(.i==$i and .c==$c and .e.schema=="polyedge.funded_direct_service.v2" and .e.status=="persistent_service_heartbeat")]|sort_by(.t)|last as $h|([$x[]|select(.i==$i and .c==$c and .e.schema=="polyedge.funded_direct_service.v2" and .e.status=="persistent_service_started" and .e.automatic_redemption_enabled==true)]|length)==1 and ([$x[]|select(.i==$i and .c==$c and .e.schema=="polyedge.funded_direct_service.v1" and .e.status=="failed_closed" and .t > $h.t)]|length)==0 and $h!=null and $h.t<=$n and $h.t>=($n-75) and ($h.e.processed_messages|type=="number" and .>0) and $h.e.failed_messages==0 and $h.e.failed_attempts==0 and $h.e.redemption_failures==0 and $h.e.executor.busy==false and $h.e.executor.user_channel_ready==true and $h.e.executor.market_channel_ready==true and $h.e.executor.user_channel_gaps==0 and $h.e.executor.market_channel_gaps==0 and $h.e.executor.user_channel_unparsed==0 and $h.e.executor.market_channel_unparsed==0 and $h.e.executor.reconnect_reconciliation_required==false and $h.e.executor.safety_snapshot_cache_ready==true and ($h.e.executor.safety_snapshot_cache_age_ms|type=="number" and .>=0 and .<=650) and $h.e.executor.safety_snapshot_open_order_count==0 and $h.e.executor.safety_snapshot_unresolved_position_count==0 and $h.e.executor.safety_snapshot_unresolved_risk_reservation_count==0 and $h.e.executor.safety_snapshot_cache_error==null and $h.e.executor.risk_reservation_index_ready==true|{capturedAtEpoch:$h.t,automaticRedemptionEnabled:true,processedMessages:$h.e.processed_messages,failedMessages:$h.e.failed_messages,failedAttempts:$h.e.failed_attempts,redemptionFailures:$h.e.redemption_failures,executor:$h.e.executor}'; }
printf '%s\n' "$run" | /usr/bin/grep -Eq '^venue-redemption-[0-9]{17}-[0-9a-f]{8}$'
printf '%s\n' "$tx" | /usr/bin/grep -Eq '^0x[0-9a-f]{64}$'
printf '%s\n' "$condition" | /usr/bin/grep -Eq '^0x[0-9a-f]{64}$'
secure "$0" 755; secure "$live" 640; secure "$dry" 640; secure "$settlement" 640
case "$live:$dry:$settlement" in *"/funded-recovery/"*) exit 1;; esac
/usr/bin/jq -e --arg run "$run" --arg tx "$tx" --arg condition "$condition" --arg blob "$settlement_blob" --arg after "$fresh_after" --argjson before "$liquid_before" --argjson after_liquid "$liquid_after" --argjson payout "$payout" '.schema_version==1 and .status=="redeemed_and_verified" and .dry_run==false and .run_id==$run and (.transaction_hash|ascii_downcase)==$tx and .redemption_submitted==true and .finished_ts>=$after and .liquid_collateral_before==$before and .liquid_collateral_after==$after_liquid and .realized_payout==$payout and .zero_open_orders_confirmed==true and .internal_settlement_blobs==[$blob] and (.selection.selected|map(.condition_id))==[$condition] and .selection.selected_gross_payout==$payout' "$live">/dev/null
/usr/bin/jq -e --arg after "$fresh_after" '.schema_version==1 and .status=="nothing_to_redeem" and .dry_run==true and .finished_ts>=$after and .zero_open_orders_confirmed==true and .portfolio.redeemable_winner_count==0 and .selection.selected_gross_payout==0 and (.selection.selected|type=="array" and length==0) and .redemption_submitted==false' "$dry">/dev/null
/usr/bin/jq -e --arg tx "$tx" --arg condition "$condition" --argjson payout "$payout" '.schema=="polyedge.verified_internal_settlement.v1" and (.transaction_hash|ascii_downcase)==$tx and .condition_id==$condition and .payout==$payout and (.receipt_confirmations|tonumber)>=2' "$settlement">/dev/null
exec 9>"$lock"; /usr/bin/flock -n 9
"$guard" --assert-headroom; ! "$systemctl" is-active --quiet polyedge-parity-hourly.timer; "$systemctl" is-active --quiet polyedge-funded-signer.service; "$systemctl" is-active --quiet polyedge-funded-intent-producer.service; test "$("$systemctl" show polyedge-funded-signer.service -p NRestarts --value)" = 0
signer_invocation=$("$systemctl" show polyedge-funded-signer.service -p InvocationID --value); signer_restarts=$("$systemctl" show polyedge-funded-signer.service -p NRestarts --value); signer_container=$("$podman" inspect --format "{{.Id}}" polyedge-funded-signer); image=$("$podman" inspect --format "{{.Config.Image}}" polyedge-funded-signer); signer_user=$("$podman" inspect --format "{{.Config.User}}" polyedge-funded-signer); printf "%s" "$image"|/usr/bin/grep -Eq "^ghcr\.io/aldoapicella/polyedge-venue-probe@sha256:[0-9a-f]{64}$"; test "$signer_user" = "986:982"; revision=$("$podman" image inspect --format "{{ index .Labels \"org.opencontainers.image.revision\" }}" "$image"); printf "%s" "$revision"|/usr/bin/grep -Eq "^[0-9a-f]{40}$"; test "$("$podman" image inspect --format "{{.Os}}/{{.Architecture}}" "$image")" = linux/arm64
producer_invocation=$("$systemctl" show polyedge-funded-intent-producer.service -p InvocationID --value); producer_restarts=$("$systemctl" show polyedge-funded-intent-producer.service -p NRestarts --value); test "$producer_restarts" = 0; producer_container=$("$podman" inspect --format "{{.Id}}" polyedge-funded-intent-producer); producer_image=$("$podman" inspect --format "{{.Config.Image}}" polyedge-funded-intent-producer); producer_user=$("$podman" inspect --format "{{.Config.User}}" polyedge-funded-intent-producer); printf "%s" "$producer_image"|/usr/bin/grep -Eq "^ghcr\.io/aldoapicella/polyedge-rust-backend@sha256:[0-9a-f]{64}$"; test "$producer_user" = "984:980"; producer_revision=$("$podman" image inspect --format "{{ index .Labels \"org.opencontainers.image.revision\" }}" "$producer_image"); printf "%s" "$producer_revision"|/usr/bin/grep -Eq "^[0-9a-f]{40}$"; test "$("$podman" image inspect --format "{{.Os}}/{{.Architecture}}" "$producer_image")" = linux/arm64; test "$("$podman" inspect --format "{{.State.Status}}|{{.State.Health.Status}}" polyedge-funded-intent-producer)" = "running|healthy"
before=$(queue); hb=$(heartbeat); after=$(queue); test "$(/usr/bin/jq -r .deadLetterMessageCount<<<"$after")" -le "$(/usr/bin/jq -r .deadLetterMessageCount<<<"$before")"; free=$(/usr/bin/df -P -B1 /|/usr/bin/awk "NR==2{print \$4}"); test "$free" -ge "$min_disk"
receipt="$out/post-redemption-$run-attestation.json"; test ! -e "$receipt"; /usr/bin/install -d -o "$uid" -g "$gid" -m 0750 "$out"; tmp=$(/usr/bin/mktemp "$out/.attestation.XXXXXX")
/usr/bin/jq -n --arg created "$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)" --arg helper "sha256:$(sha "$0")" --argjson dlq "$(/usr/bin/jq -r .deadLetterMessageCount<<<"$after")" --arg image "$image" --arg revision "$revision" --arg signer_user "$signer_user" --arg signer_invocation "$signer_invocation" --arg signer_container "$signer_container" --arg signer_restarts "$signer_restarts" --arg producer_image "$producer_image" --arg producer_revision "$producer_revision" --arg producer_user "$producer_user" --arg producer_invocation "$producer_invocation" --arg producer_container "$producer_container" --arg producer_restarts "$producer_restarts" --arg tx "$tx" --arg blob "$settlement_blob" --arg live_path "$live" --arg live_sha "sha256:$(sha "$live")" --arg dry_path "$dry" --arg dry_sha "sha256:$(sha "$dry")" --arg settlement_path "$settlement" --arg settlement_sha "sha256:$(sha "$settlement")" --argjson heartbeat "$hb" --argjson before "$before" --argjson after "$after" --argjson free "$free" --argjson min "$min_disk" '{schema:"polyedge.funded_signer_post_redemption_attestation.v1",status:"attested",createdAtUtc:$created,helperSha256:$helper,authorizedDeadLetterBaseline:$dlq,redemption:{transactionHash:$tx,settlementBlob:$blob},runtime:{signer:{invocationId:$signer_invocation,containerId:$signer_container,restartCount:($signer_restarts|tonumber),image:$image,revision:$revision,user:$signer_user},producer:{invocationId:$producer_invocation,containerId:$producer_container,restartCount:($producer_restarts|tonumber),image:$producer_image,revision:$producer_revision,user:$producer_user,status:"running",health:"healthy"}},evidence:{liveSummary:{path:$live_path,sha256:$live_sha},followUpDryRun:{path:$dry_path,sha256:$dry_sha},internalSettlement:{path:$settlement_path,sha256:$settlement_sha}},heartbeat:$heartbeat,queue:{before:$before,after:$after,deadLetterNonGrowth:true},disk:{availableBytes:$free,minimumAvailableBytes:$min},staleRecoveryReceiptsAccepted:false,servicesMutated:false,parityTimerRemainsPaused:true,azureDeletionAllowed:false}' >"$tmp"
/usr/bin/chown "$uid:$gid" "$tmp"; /usr/bin/chmod 640 "$tmp"; /usr/bin/sync -f "$tmp"; /usr/bin/ln "$tmp" "$receipt"; /usr/bin/sync -f "$out"; /usr/bin/rm -f "$tmp"; printf "attested post-redemption signer state: %s\n" "$receipt"
