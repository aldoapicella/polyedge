#!/bin/bash
set +x
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

readonly expected_tenant_id=9767f0dc-e83f-4cc1-94e1-0d5f9d287d32
readonly expected_client_id=d9ce9154-66a6-4bdb-839f-0da7b02b38da
readonly vault_name=kvpolyedge6urdjr5nmwx7w
readonly max_secret_bytes=65536

die() {
  printf 'polyedge-funded-secret-bootstrap: %s\n' "$*" >&2
  if ((${#created_names[@]})); then
    local joined
    printf -v joined '%s, ' "${created_names[@]}"
    printf 'polyedge-funded-secret-bootstrap: incomplete; created before failure: %s\n' "${joined%, }" >&2
  fi
  exit 1
}

created_names=()
auth_header=
work_dir=
cleanup() {
  unset access_token encoded_value
  [[ -z "$auth_header" ]] || rm -f -- "$auth_header"
  [[ -z "$work_dir" ]] || rmdir -- "$work_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

test_mode=${POLYEDGE_FUNDED_SECRET_BOOTSTRAP_TEST:-0}
if [[ "$test_mode" == 1 ]]; then
  curl_bin=${POLYEDGE_FUNDED_SECRET_CURL:-curl}
  jq_bin=${POLYEDGE_FUNDED_SECRET_JQ:-jq}
  podman_bin=${POLYEDGE_FUNDED_SECRET_PODMAN:-podman}
  systemctl_bin=${POLYEDGE_FUNDED_SECRET_SYSTEMCTL:-systemctl}
  token_file=${POLYEDGE_FUNDED_SECRET_TOKEN_FILE:?test token file is required}
  runtime_parent=${POLYEDGE_FUNDED_SECRET_RUNTIME_PARENT:?test runtime parent is required}
  expected_uid=$(id -u)
  expected_gid=$(id -g)
else
  [[ $(id -u) == 0 ]] || die 'must run as root'
  readonly curl_bin=/usr/bin/curl
  readonly jq_bin=/usr/bin/jq
  readonly podman_bin=/usr/bin/podman
  readonly systemctl_bin=/usr/bin/systemctl
  readonly token_file=/run/polyedge-federated-funded-signer/azure-federated-token
  readonly runtime_parent=/run
  expected_uid=$(id -u polyedge-identity-funded-signer) || die 'funded-signer identity is missing'
  expected_gid=$(id -g polyedge-identity-funded-signer) || die 'funded-signer identity is missing'
fi

[[ ${AZURE_TENANT_ID:-} == "$expected_tenant_id" ]] || die 'AZURE_TENANT_ID is missing or not the approved tenant'
[[ ${AZURE_CLIENT_ID:-} == "$expected_client_id" ]] || die 'AZURE_CLIENT_ID is missing or not the funded-signer UAMI'
[[ -x "$curl_bin" && -x "$jq_bin" && -x "$podman_bin" && -x "$systemctl_bin" && -x /usr/bin/base64 ]] \
  || die 'curl, jq, podman, systemctl, or base64 is unavailable'

if "$systemctl_bin" is-active --quiet polyedge-funded-signer.service; then
  die 'funded signer is active'
else
  status=$?
  [[ $status == 3 ]] || die 'cannot prove the funded signer is inactive'
fi

token_dir=${token_file%/*}
[[ ! -L "$token_dir" && -d "$token_dir" ]] || die 'funded-signer token directory is missing or unsafe'
read -r dir_uid dir_gid dir_mode < <(stat -c '%u %g %a' "$token_dir")
[[ "$dir_uid:$dir_gid:$dir_mode" == "$expected_uid:$expected_gid:700" ]] \
  || die 'funded-signer token directory has wrong owner or mode'
[[ ! -L "$token_file" && -f "$token_file" ]] || die 'funded-signer JWT-SVID is missing or unsafe'
read -r token_device token_inode token_uid token_gid token_mode token_links token_size \
  < <(stat -c '%d %i %u %g %a %h %s' "$token_file")
[[ "$token_uid:$token_gid:$token_mode:$token_links" == "$expected_uid:$expected_gid:600:1" ]] \
  || die 'funded-signer JWT-SVID has wrong owner, mode, or link count'
((token_size > 0 && token_size <= 16384)) || die 'funded-signer JWT-SVID size is invalid'
LC_ALL=C IFS= read -r jwt_value <"$token_file" || [[ -n ${jwt_value:-} ]]
[[ ${#jwt_value} == "$token_size" && "$jwt_value" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]] \
  || die 'funded-signer JWT-SVID shape is invalid'
unset jwt_value

# Pin the checked inode so an atomic token refresh cannot change the assertion mid-read.
exec 3<"$token_file"
read -r pinned_device pinned_inode pinned_uid pinned_gid pinned_mode pinned_links pinned_size \
  < <(stat -Lc '%d %i %u %g %a %h %s' /proc/self/fd/3)
[[ "$pinned_device:$pinned_inode:$pinned_uid:$pinned_gid:$pinned_mode:$pinned_links:$pinned_size" == \
   "$token_device:$token_inode:$token_uid:$token_gid:$token_mode:$token_links:$token_size" ]] \
  || die 'funded-signer JWT-SVID changed during validation'

readonly -a mappings=(
  'polymarket-private-key:polyedge-polymarket-private-key'
  'polymarket-api-key:polyedge-polymarket-api-key'
  'polymarket-api-secret:polyedge-polymarket-api-secret'
  'polymarket-api-passphrase:polyedge-polymarket-api-passphrase'
  'polymarket-relayer-api-key:polyedge-polymarket-relayer-api-key'
)

for mapping in "${mappings[@]}"; do
  podman_name=${mapping#*:}
  if "$podman_bin" secret exists "$podman_name" >/dev/null 2>&1; then
    die "refusing pre-existing Podman secret: $podman_name"
  else
    status=$?
    [[ $status == 1 ]] || die "cannot inspect Podman secret: $podman_name"
  fi
done

[[ ! -L "$runtime_parent" && -d "$runtime_parent" ]] || die 'runtime parent is missing or unsafe'
umask 077
work_dir=$(mktemp -d "$runtime_parent/polyedge-funded-secret-bootstrap.XXXXXX")
[[ ! -L "$work_dir" && $(stat -c '%u:%g:%a' "$work_dir") == "$(id -u):$(id -g):700" ]] \
  || die 'temporary runtime directory is unsafe'
auth_header=$(mktemp "$work_dir/auth-header.XXXXXX")
[[ ! -L "$auth_header" && $(stat -c '%u:%g:%a:%h' "$auth_header") == "$(id -u):$(id -g):600:1" ]] \
  || die 'temporary authorization header is unsafe'

if ! access_token=$("$curl_bin" --silent --show-error --fail --max-time 30 --connect-timeout 10 \
  --proto '=https' --tlsv1.2 \
  --request POST "https://login.microsoftonline.com/$expected_tenant_id/oauth2/v2.0/token" \
  --data-urlencode grant_type=client_credentials \
  --data-urlencode "client_id=$expected_client_id" \
  --data-urlencode scope=https://vault.azure.net/.default \
  --data-urlencode client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer \
  --data-urlencode client_assertion@/proc/self/fd/3 \
  | "$jq_bin" -erj '.access_token | select(type == "string" and length > 0 and utf8bytelength <= 16384 and (test("[\\r\\n]") | not))'); then
  die 'funded-signer UAMI token exchange failed'
fi
printf 'Authorization: Bearer %s\n' "$access_token" >"$auth_header"
unset access_token

for mapping in "${mappings[@]}"; do
  vault_secret=${mapping%%:*}
  podman_name=${mapping#*:}
  if ! encoded_value=$("$curl_bin" --silent --show-error --fail --max-time 30 --connect-timeout 10 \
    --max-filesize 131072 --proto '=https' --tlsv1.2 \
    --header @"$auth_header" \
    "https://$vault_name.vault.azure.net/secrets/$vault_secret?api-version=7.4" \
    | "$jq_bin" -erj --argjson max "$max_secret_bytes" '
        if type == "object" and (.value | type == "string") and
          (.value | utf8bytelength > 0 and utf8bytelength <= $max)
        then .value | @base64
        else error("invalid bounded Key Vault secret value")
        end'); then
    die "Key Vault read failed or returned an invalid value: $vault_secret"
  fi
  if ! printf '%s' "$encoded_value" | /usr/bin/base64 --decode | "$podman_bin" secret create "$podman_name" - >/dev/null; then
    unset encoded_value
    die "Podman secret creation failed: $podman_name"
  fi
  unset encoded_value
  created_names+=("$podman_name")
done

printf 'polyedge-funded-secret-bootstrap: created %d funded Podman secrets\n' "${#created_names[@]}"
