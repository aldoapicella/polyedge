#!/usr/bin/env bash
set -euo pipefail
umask 027

readonly mode=${1:-}
readonly boundary=2026-08-24T00:00:00Z
readonly boundary_epoch=1787529600
readonly v4_service=polyedge-shadow-qset-v4.service
readonly v4_container=polyedge-shadow-qset-v4
readonly v3_service=polyedge-shadow-qset-v3.service
readonly v2_service=polyedge-shadow-qset.service
readonly v2_seal_timer=polyedge-qset-v2-first-seal.timer
readonly v4_env=/etc/polyedge/shadow-qset-v4.env
readonly receipt_root=/srv/polyedge-ring/migration/qset-v4/boundary
readonly pre_receipt=$receipt_root/20260824T000000Z-pre.json
readonly post_receipt=$receipt_root/20260824T000000Z-post.json

case "$mode" in check|pre|post) ;; *) echo "usage: ${0##*/} check|pre|post" >&2; exit 64 ;; esac

temporary=()
cleanup() {
  local path
  trap - EXIT HUP INT TERM
  for path in "${temporary[@]:-}"; do test -z "$path" || rm -f -- "$path"; done
}
trap cleanup EXIT HUP INT TERM

secure_file() {
  local path=$1 mode=$2 max=$3
  test ! -L "$path" && test -f "$path"
  test "$(stat -c '%u:%g:%a:%h' "$path")" = "0:0:$mode:1"
  test "$(stat -c '%s' "$path")" -gt 0 && test "$(stat -c '%s' "$path")" -le "$max"
}

load_final_v4_binding() {
  secure_file "$v4_env" 600 65536
  set -a
  . "$v4_env"
  set +a
  test "${SHADOW_CAMPAIGN_ID:-}" = campaign-2026-08-24-qset-v4
  test "${SHADOW_EVIDENCE_VERSION:-}" = protocol-v3-qset-v4
  test "${SHADOW_CODE_FREEZE_FINALIZED:-}" = true
  printf '%s' "${SHADOW_CODE_FREEZE_SHA256:-}" | grep -Eq '^sha256:[0-9a-f]{64}$'
  test "${EXECUTION_FREEZE_SHA256:-}" = "$SHADOW_CODE_FREEZE_SHA256"
  case "${EXECUTION_FREEZE_ARTIFACT_PATH:-}" in reports/research/shadow/campaigns/campaign-2026-08-24-qset-v4/control/code-freeze/source-${SHADOW_CODE_FREEZE_SHA256#sha256:}.json) ;; *) exit 64 ;; esac
  test "${SHADOW_CODE_FREEZE_MANIFEST:-}" = "azure://${AZURE_STORAGE_ACCOUNT_NAME:?}/polyedge-qset-v4-control/$EXECUTION_FREEZE_ARTIFACT_PATH"
  printf '%s' "${POLYEDGE_QSET_V4_WRITER_IMAGE:-}" | grep -Eq '^ghcr\.io/[a-z0-9][a-z0-9._-]*/polyedge-rust-backend@sha256:[0-9a-f]{64}$'
  printf '%s' "${POLYEDGE_QSET_V4_WRITER_GIT_SHA:-}" | grep -Eq '^[0-9a-f]{40}$'
}

runtime_status() {
  timeout 30 podman exec "$v4_container" /usr/bin/bash -ec 'exec 3<>/dev/tcp/127.0.0.1/8081; printf "GET /api/v1/status HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n" >&3; cat <&3' | tr -d '\r' | sed '1,/^$/d'
}

container_env_is() {
  local expected=$1
  timeout 20 podman inspect "$v4_container" --format '{{range .Config.Env}}{{println .}}{{end}}' | grep -Fx -- "$expected" >/dev/null
}

validate_v4_recorder() {
  jq -e '
    .app == "polyedge-shadow-qset-v4" and .execution_mode == "paper" and
    .intent_publisher == {configured:true,prepared:true,pointer_only_preflight:true} and
    .task_health == {api:"ok",runtime_loop:"running",feeds:"running"} and
    (.recorder_metrics.recorder_instance_id | type == "string" and length > 0) and
    .recorder_metrics.last_assigned_sequence > 0 and .recorder_metrics.persisted_total > 0 and
    .recorder_metrics.queued == 0 and .recorder_metrics.failed_total == 0 and
    .recorder_metrics.unrecovered_durable_events == 0 and .recorder_metrics.flush_failed_total == 0 and
    .recorder_metrics.flush_unrecovered == false and .recorder_status.busy == false and
    .recorder_status.error_count == 0 and .recorder_status.dropped_count == 0
  ' >/dev/null
}

disabled() { ! systemctl is-active --quiet "$1" && ! systemctl is-enabled --quiet "$1"; }

validate_v2() {
  timeout 15 systemctl is-active --quiet "$v2_seal_timer"
  timeout 15 systemctl is-enabled --quiet "$v2_seal_timer"
  timeout 15 systemctl is-active --quiet "$v2_service"
  timeout 30 podman inspect --format '{{.State.Status}}|{{.State.Health.Status}}' polyedge-shadow-qset | grep -qx 'running|healthy'
}

common_guard() {
  timeout 30 /usr/local/libexec/polyedge-boot-disk-guard --assert-headroom
  test ! -e /run/polyedge/image-pulls-paused
  load_final_v4_binding
  disabled "$v3_service"
  disabled polyedge-qset-v3-boundary-pre.timer
  disabled polyedge-qset-v3-boundary-post.timer
  disabled polyedge-qset-v3-first-seal.timer
  timeout 15 systemctl is-active --quiet "$v4_service"
  test "$(timeout 30 podman inspect --format '{{.Config.Image}}|{{.Config.User}}|{{.State.Status}}|{{.State.Health.Status}}' "$v4_container")" = "$POLYEDGE_QSET_V4_WRITER_IMAGE|983:979|running|healthy"
  test "$(timeout 30 podman image inspect --format '{{.Os}}/{{.Architecture}}|{{ index .Labels \"org.opencontainers.image.revision\" }}' "$POLYEDGE_QSET_V4_WRITER_IMAGE")" = "linux/arm64|$POLYEDGE_QSET_V4_WRITER_GIT_SHA"
  container_env_is 'SHADOW_CAMPAIGN_ID=campaign-2026-08-24-qset-v4'
  container_env_is 'SHADOW_EVIDENCE_VERSION=protocol-v3-qset-v4'
  container_env_is 'SHADOW_CODE_FREEZE_FINALIZED=true'
  container_env_is "SHADOW_CODE_FREEZE_SHA256=$SHADOW_CODE_FREEZE_SHA256"
  container_env_is "EXECUTION_FREEZE_SHA256=$SHADOW_CODE_FREEZE_SHA256"
  container_env_is "EXECUTION_FREEZE_ARTIFACT_PATH=$EXECUTION_FREEZE_ARTIFACT_PATH"
  container_env_is 'AZURE_STORAGE_CONTAINER_NAME=polyedge-shadow-qset-v4-events'
  container_env_is 'AZURE_RESEARCH_STORAGE_CONTAINER_NAME=polyedge-research-qset-v4'
  container_env_is 'POLYEDGE_QSET_V4_CONTROL_CONTAINER_NAME=polyedge-qset-v4-control'
  container_env_is 'AZURE_EVENT_BLOB_PREFIX=shadow-events/preflight/campaign-2026-08-24-qset-v4'
  container_env_is 'AZURE_EVENT_BLOB_PREFIX_AFTER_CUTOVER=shadow-events/campaign-2026-08-24-qset-v4'
  container_env_is 'AZURE_EVENT_BLOB_PREFIX_CUTOVER_UTC=2026-08-24T00:00:00Z'
  container_env_is 'STRATEGY_CANARY_INTENT_PREFIX=control/strategy-canary/intents/campaign-2026-08-24-qset-v4/intents'
  container_env_is "POLYEDGE_QSET_V4_WRITER_IMAGE=$POLYEDGE_QSET_V4_WRITER_IMAGE"
  container_env_is "POLYEDGE_QSET_V4_WRITER_GIT_SHA=$POLYEDGE_QSET_V4_WRITER_GIT_SHA"
  runtime_status | validate_v4_recorder
  validate_v2
}

commit_receipt() {
  local temporary_receipt=$1 final_receipt=$2
  chown root:root "$temporary_receipt" && chmod 0640 "$temporary_receipt"
  test ! -e "$final_receipt"
  ln "$temporary_receipt" "$final_receipt"
}

if test "$mode" = check; then common_guard; printf '%s\n' 'qset-v4 boundary guard check passed; no state changed'; exit 0; fi

exec 9>/run/polyedge/qset-v4-boundary.lock
flock -n 9 || { echo 'qset-v4 boundary guard is already running' >&2; exit 75; }
install -d -o root -g root -m 0750 "$receipt_root"

if test "$mode" = pre; then
  now=$(date -u +%s); test "$now" -ge $((boundary_epoch - 120)) && test "$now" -lt "$boundary_epoch"
  common_guard; test ! -e "$pre_receipt"
  status_tmp=$(mktemp /run/polyedge/qset-v4-pre-status.XXXXXX); receipt_tmp=$(mktemp "$receipt_root/.pre.XXXXXX"); temporary+=("$status_tmp" "$receipt_tmp")
  runtime_status >"$status_tmp"; validate_v4_recorder <"$status_tmp"
  jq -n --arg generated "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg pid "$(systemctl show "$v4_service" -p MainPID --value)" --arg invocation "$(systemctl show "$v4_service" -p InvocationID --value)" --arg container "$(podman inspect --format '{{.Id}}' "$v4_container")" --arg image "$POLYEDGE_QSET_V4_WRITER_IMAGE" --arg revision "$POLYEDGE_QSET_V4_WRITER_GIT_SHA" --arg freeze "$SHADOW_CODE_FREEZE_SHA256" --arg freeze_blob "$EXECUTION_FREEZE_ARTIFACT_PATH" --slurpfile status "$status_tmp" '{schema:"polyedge.qset_v4_boundary_pre.v1",generatedAtUtc:$generated,boundaryUtc:"2026-08-24T00:00:00Z",writer:{mainPid:($pid|tonumber),invocationId:$invocation,containerId:$container,image:$image,revision:$revision,freezeSha256:$freeze,freezeBlob:$freeze_blob,status:$status[0]},qsetV3:{stoppedAndDisabled:true},qsetV2:{healthy:true,firstSealTimerStillEnabled:true},azureEvidenceMutationPerformed:false}' >"$receipt_tmp"
  test "$(date -u +%s)" -lt "$boundary_epoch"; commit_receipt "$receipt_tmp" "$pre_receipt"; exit 0
fi

now=$(date -u +%s); test "$now" -ge "$boundary_epoch" && test "$now" -le $((boundary_epoch + 900))
common_guard; secure_file "$pre_receipt" 640 1048576
pre_pid=$(jq -er '.writer.mainPid' "$pre_receipt"); pre_invocation=$(jq -er '.writer.invocationId' "$pre_receipt"); pre_container=$(jq -er '.writer.containerId' "$pre_receipt")
test "$(systemctl show "$v4_service" -p MainPID --value)" = "$pre_pid"; test "$(systemctl show "$v4_service" -p InvocationID --value)" = "$pre_invocation"; test "$(podman inspect --format '{{.Id}}' "$v4_container")" = "$pre_container"
status_tmp=$(mktemp /run/polyedge/qset-v4-post-status.XXXXXX); receipt_tmp=$(mktemp "$receipt_root/.post.XXXXXX"); temporary+=("$status_tmp" "$receipt_tmp")
runtime_status >"$status_tmp"; validate_v4_recorder <"$status_tmp"; validate_v2
jq -n --arg generated "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg pre_sha "sha256:$(sha256sum "$pre_receipt" | cut -d' ' -f1)" --slurpfile status "$status_tmp" '{schema:"polyedge.qset_v4_boundary_post.v1",generatedAtUtc:$generated,boundaryUtc:"2026-08-24T00:00:00Z",preReceiptSha256:$pre_sha,writerContinued:true,writerPostStatus:$status[0],qsetV3:{stoppedAndDisabled:true},qsetV2:{healthyBeforeTimerDisable:true},azureEvidenceMutationPerformed:false}' >"$receipt_tmp"
commit_receipt "$receipt_tmp" "$post_receipt"
systemctl disable --now "$v2_seal_timer"
disabled "$v2_seal_timer"
logger -p daemon.info -t polyedge-qset-v4-boundary 'v4 boundary receipts committed; disabled unsafe qset-v2 first-seal timer without Azure evidence mutation'
