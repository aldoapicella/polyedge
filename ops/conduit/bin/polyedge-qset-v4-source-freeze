#!/usr/bin/env bash
set -euo pipefail
umask 027

readonly repo=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
readonly policy=$repo/research/configs/campaign_freeze_2026-08-24_qset_v4.json
readonly campaign_id=campaign-2026-08-24-qset-v4
readonly evidence_version=protocol-v3-qset-v4
readonly control_container=polyedge-qset-v4-control

usage() { echo "usage: ${0##*/} build OUTPUT | lock-and-upload MANIFEST" >&2; exit 64; }
secure_manifest() { test ! -L "$1" && test -f "$1" && test "$(stat -c '%s' "$1")" -gt 0 && test "$(stat -c '%s' "$1")" -le 1048576; }

build() {
  local output=$1 temporary files
  : "${FREEZE_RESEARCH_IMAGE:?FREEZE_RESEARCH_IMAGE is required}"
  printf '%s' "$FREEZE_RESEARCH_IMAGE" | grep -Eq '^ghcr\.io/[a-z0-9][a-z0-9._-]*/polyedge-rust-backend@sha256:[0-9a-f]{64}$'
  git -C "$repo" diff --quiet && git -C "$repo" diff --cached --quiet
  files=$(mktemp); temporary=$(mktemp "$(dirname "$output")/.qset-v4-freeze.XXXXXX")
  trap 'rm -f "$files" "$temporary"' EXIT HUP INT TERM
  jq -r '.protected_files[]' "$policy" | LC_ALL=C sort -u >"$files"
  test "$(wc -l <"$files")" -gt 0
  while IFS= read -r file; do
    test -f "$repo/$file" && test ! -L "$repo/$file"
    git -C "$repo" ls-files --error-unmatch -- "$file" >/dev/null
  done <"$files"
  while IFS= read -r file; do
    jq -nc --arg path "$file" --arg sha256 "sha256:$(sha256sum "$repo/$file" | cut -d' ' -f1)" --argjson bytes "$(wc -c <"$repo/$file")" '{path:$path,sha256:$sha256,bytes:$bytes}'
  done <"$files" | jq -s --arg campaign_id "$campaign_id" --arg evidence_version "$evidence_version" --arg source_commit "$(git -C "$repo" rev-parse HEAD)" --arg git_tree "$(git -C "$repo" rev-parse 'HEAD^{tree}')" --arg research_image "$FREEZE_RESEARCH_IMAGE" --arg contract_sha256 "sha256:$(sha256sum "$repo/research/configs/profitability_gate_v3_2026-08-24_qset_v4.yaml" | cut -d' ' -f1)" --arg policy_sha256 "sha256:$(sha256sum "$policy" | cut -d' ' -f1)" '{schema:"polyedge.shadow_source_freeze.v1",campaign_id:$campaign_id,evidence_version:$evidence_version,source_commit:$source_commit,git_tree:$git_tree,research_image:$research_image,campaign_contract_sha256:$contract_sha256,freeze_policy_sha256:$policy_sha256,critical_files:.}' >"$temporary"
  jq -e --arg id "$campaign_id" --arg version "$evidence_version" '.campaign_id == $id and .evidence_version == $version and (.critical_files | length > 0)' "$temporary" >/dev/null
  chmod 0640 "$temporary"; mv -n "$temporary" "$output"
}

lock_and_upload() {
  local manifest=$1 digest blob temporary
  : "${AZURE_STORAGE_ACCOUNT_NAME:?AZURE_STORAGE_ACCOUNT_NAME is required}"
  secure_manifest "$manifest"
  digest=$(sha256sum "$manifest" | cut -d' ' -f1)
  blob="reports/research/shadow/campaigns/$campaign_id/control/code-freeze/source-$digest.json"
  jq -e --arg id "$campaign_id" --arg version "$evidence_version" '.campaign_id == $id and .evidence_version == $version' "$manifest" >/dev/null
  policy_json=$(az storage container immutability-policy show --auth-mode login --account-name "$AZURE_STORAGE_ACCOUNT_NAME" --container-name "$control_container" -o json)
  state=$(jq -r .state <<<"$policy_json")
  if test "$state" != Locked; then
    etag=$(jq -er .etag <<<"$policy_json")
    az storage container immutability-policy lock --auth-mode login --account-name "$AZURE_STORAGE_ACCOUNT_NAME" --container-name "$control_container" --if-match "$etag" >/dev/null
  fi
  test "$(az storage container immutability-policy show --auth-mode login --account-name "$AZURE_STORAGE_ACCOUNT_NAME" --container-name "$control_container" --query state -o tsv)" = Locked
  az storage blob upload --auth-mode login --account-name "$AZURE_STORAGE_ACCOUNT_NAME" --container-name "$control_container" --name "$blob" --file "$manifest" --overwrite false >/dev/null
  temporary=$(mktemp); trap 'rm -f "$temporary"' EXIT HUP INT TERM
  az storage blob download --auth-mode login --account-name "$AZURE_STORAGE_ACCOUNT_NAME" --container-name "$control_container" --name "$blob" --file "$temporary" >/dev/null
  test "$(sha256sum "$temporary" | cut -d' ' -f1)" = "$digest"
  printf 'azure://%s/%s/%s\nsha256:%s\n' "$AZURE_STORAGE_ACCOUNT_NAME" "$control_container" "$blob" "$digest"
}

case "${1:-}" in build) test "$#" = 2 || usage; build "$2" ;; lock-and-upload) test "$#" = 2 || usage; lock_and_upload "$2" ;; *) usage ;; esac
