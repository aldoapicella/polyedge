validate_producer_evidence() {
  jq -e --arg image "$funded_producer_image" --arg user "$funded_producer_user" \
    --arg config_sha "$funded_producer_config_sha" --arg env_binding_sha "$funded_producer_env_binding_sha" \
    --arg mount_binding_sha "$funded_producer_mount_binding_sha" --argjson funded "$funded_enabled" \
    --arg service_bus_namespace "$funded_service_bus_namespace" --arg service_bus_queue "$funded_service_bus_queue" \
    --arg expected_service_bus_dlq "$funded_service_bus_dlq" '
    def epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    (.hourStartUtc | epoch) as $start |
    (.hourEndUtc | epoch) as $end |
    .services.fundedIntentProducerEnabled == $funded and
    (if $funded then
      .services.fundedIntentProducerActive == true and
      (.services.fundedIntentProducerEnablement == "enabled" or .services.fundedIntentProducerEnablement == "generated") and
      .services.fundedIntentProducerTokenTimerEnablement == "enabled" and
      .services.fundedIntentProducerTokenTimerActive == true and
      .services.fundedIntentProducerImage == $image and .services.fundedIntentProducerUser == $user and
      .services.fundedIntentProducerConfigSha256 == $config_sha and
      (.services.fundedIntentProducerRuntime.containerId | test("^[0-9a-f]{64}$")) and
      (.services.fundedIntentProducerRuntime.invocationId | test("^[0-9a-f]{32}$")) and
      .services.fundedIntentProducerRuntime.configEnvBindingSha256 == $env_binding_sha and
      .services.fundedIntentProducerRuntime.tokenMountBindingSha256 == $mount_binding_sha and
      .services.fundedIntentProducerRuntime.continuity.invocationId == .services.fundedIntentProducerRuntime.invocationId and
      .services.fundedIntentProducerRuntime.continuity.containerId == .services.fundedIntentProducerRuntime.containerId and
      .services.fundedIntentProducerRuntime.continuity.observationCount >= 50 and
      .services.fundedIntentProducerRuntime.continuity.maxGapSeconds <= 75 and
      .services.fundedIntentProducerRuntime.continuity.foreignObservationCount == 0 and
      .services.fundedIntentProducerRuntime.continuity.restartCount == 0 and
      ((.services.fundedIntentProducerRuntime.continuity.firstObservationUtc | epoch) >= $start) and
      ((.services.fundedIntentProducerRuntime.continuity.firstObservationUtc | epoch) <= ($start + 75)) and
      ((.services.fundedIntentProducerRuntime.continuity.lastObservationUtc | epoch) >= ($end - 75)) and
      ((.services.fundedIntentProducerRuntime.continuity.lastObservationUtc | epoch) < $end) and
      .services.fundedIntentProducerRuntime.continuity.publisher.successCount >= 1 and
      .services.fundedIntentProducerRuntime.continuity.publisher.successCount ==
        (.services.fundedIntentProducerRuntime.continuity.publisher.warmupSentCount +
         .services.fundedIntentProducerRuntime.continuity.publisher.intentPublishedCount) and
      .services.fundedIntentProducerRuntime.continuity.publisher.infrastructureFailureCount == 0 and
      ((.services.fundedIntentProducerRuntime.continuity.publisher.firstSuccessUtc | epoch) >= $start) and
      ((.services.fundedIntentProducerRuntime.continuity.publisher.firstSuccessUtc | epoch) < $end) and
      ((.services.fundedIntentProducerRuntime.continuity.publisher.lastSuccessUtc | epoch) >= $start) and
      ((.services.fundedIntentProducerRuntime.continuity.publisher.lastSuccessUtc | epoch) < $end) and
      .services.fundedIntentProducerRuntime.tokenContinuity.tokenRefreshCount >= 20 and
      .services.fundedIntentProducerRuntime.tokenContinuity.tokenRefreshFailureCount == 0 and
      .services.fundedIntentProducerRuntime.tokenContinuity.maxTokenRefreshGapSeconds <= 180 and
      ((.services.fundedIntentProducerRuntime.tokenContinuity.firstTokenRefreshUtc | epoch) >= $start) and
      ((.services.fundedIntentProducerRuntime.tokenContinuity.firstTokenRefreshUtc | epoch) <= ($start + 180)) and
      ((.services.fundedIntentProducerRuntime.tokenContinuity.lastTokenRefreshUtc | epoch) >= ($end - 180)) and
      ((.services.fundedIntentProducerRuntime.tokenContinuity.lastTokenRefreshUtc | epoch) < $end) and
      .services.fundedIntentProducerRuntime.health == {
        ok:true,backendImpl:"rust",runtimeRole:"profitability_shadow",shadowOnly:true,
        runtimeActive:true,executionMode:"paper",killSwitch:false} and
      .services.fundedIntentProducerRuntime.status.app == "polyedge-funded-intent-producer" and
      .services.fundedIntentProducerRuntime.status.runtimeRole == "profitability_shadow" and
      .services.fundedIntentProducerRuntime.status.executionMode == "paper" and
      .services.fundedIntentProducerRuntime.status.intentPublisher == {
        configured:true,prepared:true,pointerOnlyPreflight:false} and
      .services.fundedIntentProducerRuntime.status.taskHealth == {api:"ok",runtimeLoop:"running",feeds:"running"} and
      all(.services.fundedIntentProducerRuntime.status.feedStatus[]; .status == "ok") and
      .services.fundedIntentProducerRuntime.status.recorder.queued == 0 and
      .services.fundedIntentProducerRuntime.status.recorder.enqueuedTotal == .services.fundedIntentProducerRuntime.status.recorder.persistedTotal and
      .services.fundedIntentProducerRuntime.status.recorder.failedTotal == 0 and
      .services.fundedIntentProducerRuntime.status.recorder.unrecoveredDurableEvents == 0 and
      .services.fundedIntentProducerRuntime.status.recorder.flushUnrecovered == false and
      .services.fundedIntentProducerRuntime.status.recorder.errorCount == 0 and
      .services.fundedIntentProducerRuntime.status.recorder.droppedCount == 0 and
      .services.fundedServiceBusRuntime == {
        namespace:$service_bus_namespace,queue:$service_bus_queue,status:"Active",
        activeMessageCount:0,scheduledMessageCount:0,
        deadLetterMessageCount:($expected_service_bus_dlq | tonumber),
        expectedDeadLetterMessageCount:($expected_service_bus_dlq | tonumber)}
     else .services.fundedIntentProducerActive == false and
      (.services.fundedIntentProducerEnablement == "disabled" or
       .services.fundedIntentProducerEnablement == "masked") and
      .services.fundedIntentProducerTokenTimerActive == false and
      (.services.fundedIntentProducerTokenTimerEnablement == "disabled" or
       .services.fundedIntentProducerTokenTimerEnablement == "masked") and
