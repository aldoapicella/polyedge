#!/bin/sh
set -eu

die() { echo "polyedge-parity-hourly: $*" >&2; exit 1; }
immutable_hour_rejection() { echo "polyedge-parity-hourly: $*" >&2; exit 78; }
sha() { printf 'sha256:%s\n' "$(sha256sum "$1" | awk '{print $1}')"; }

if [ "${POLYEDGE_PARITY_UTILITY_LOCKED:-0}" != 1 ]; then
  POLYEDGE_PARITY_TARGET_HOUR_UTC=${POLYEDGE_PARITY_TARGET_HOUR_UTC:-$(date -u -d '1 hour ago' +%Y-%m-%dT%H:00:00Z)}
  export POLYEDGE_PARITY_TARGET_HOUR_UTC
  exec /usr/bin/flock -w 3600 /run/polyedge/utility.lock \
    /usr/bin/env POLYEDGE_PARITY_UTILITY_LOCKED=1 "$0" "$@"
fi

expected_uid=${POLYEDGE_PARITY_EXPECTED_UID:-0}
expected_gid=${POLYEDGE_PARITY_EXPECTED_GID:-0}
secure_file() {
  file=$1 mode=$2
  [ ! -L "$file" ] && [ -f "$file" ] || die "unsafe or missing file: $file"
  set -- $(stat -c '%u %g %a %h' "$file")
  [ "$1" = "$expected_uid" ] && [ "$2" = "$expected_gid" ] && [ "$3" = "$mode" ] && [ "$4" = 1 ] \
    || die "wrong owner, mode, or link count: $file"
}
secure_dir() {
  dir=$1 mode=$2
  [ ! -L "$dir" ] && [ -d "$dir" ] || die "unsafe or missing directory: $dir"
  set -- $(stat -c '%u %g %a' "$dir")
  [ "$1" = "$expected_uid" ] && [ "$2" = "$expected_gid" ] && [ "$3" = "$mode" ] || die "wrong owner or mode: $dir"
}

validate_attestation() (
  report=$1 attestation=$2 platform=$3 image=$4 job_name=${5:-}
  [ ! -L "$report" ] && [ -f "$report" ] && [ "$(stat -c %h "$report")" = 1 ] || die "unsafe or missing report: $report"
  secure_file "$attestation" 640
  report_sha=$(sha "$report")
  case "$platform" in
    azure_container_apps_job)
      jq -e --arg sha "$report_sha" --arg image "$image" --arg job "$job_name" '
        .schema_version == 1 and .report_sha256 == $sha and
        .platform == "azure_container_apps_job" and .image == $image and .job_name == $job and
        (.execution_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"))
      ' "$attestation" >/dev/null || die "invalid Azure execution attestation: $attestation"
      jq -e --arg image "$image" --arg job "$job_name" --arg execution "$(jq -r '.execution_id' "$attestation")" '
        .generator_provenance == {schema_version:1,platform:"azure_container_apps_job",
          image:$image,execution_id:$execution,job_name:$job}
      ' "$report" >/dev/null || die "Azure report provenance does not match its attestation: $report"
      ;;
    oci_podman)
      jq -e --arg sha "$report_sha" --arg image "$image" '
        .schema_version == 1 and .report_sha256 == $sha and .platform == "oci_podman" and
        .image == $image and
        (.execution_id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")) and
        (.image_digest | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        (.container_id | type == "string" and test("^[0-9a-f]{64}$"))
      ' "$attestation" >/dev/null || die "invalid OCI execution attestation: $attestation"
      jq -e --arg image "$image" --arg execution "$(jq -r '.execution_id' "$attestation")" '
        .generator_provenance == {schema_version:1,platform:"oci_podman",
          image:$image,execution_id:$execution,job_name:null}
      ' "$report" >/dev/null || die "OCI report provenance does not match its attestation: $report"
      ;;
    *) die "unsupported attestation platform: $platform" ;;
  esac
)

sequence_evidence() {
  jq -ce '
    def valid_run:
      type == "object" and
      (.recorder_instance_id | type == "string" and test("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")) and
      (.recorder_first_sequence | type == "number" and floor == . and . >= 1) and
      (.recorder_last_sequence | type == "number" and floor == .) and
      (.recorder_last_sequence >= .recorder_first_sequence) and
      (.recorder_event_count | type == "number" and floor == . and . >= 1) and
      (.recorder_last_sequence - .recorder_first_sequence + 1 == .recorder_event_count);
    def valid_runs:
      . as $runs |
      ($runs | length) >= 1 and all($runs[]; valid_run) and
      all(range(1; ($runs | length)); . as $index |
        if $runs[$index].recorder_instance_id == $runs[$index - 1].recorder_instance_id then
          $runs[$index].recorder_first_sequence == ($runs[$index - 1].recorder_last_sequence + 1)
        else
          $runs[$index].recorder_first_sequence == 1 and
          ([$runs[0:$index][].recorder_instance_id] | index($runs[$index].recorder_instance_id) | not)
        end);
    if .recorderSequence? != null then
      if .recorderRuns? == null and (.recorderSequence | valid_run) then [.recorderSequence] else error("invalid recorder sequence evidence") end
    elif (.recorderRuns | type) == "array" then .recorderRuns
    else error("invalid recorder sequence evidence")
    end | if valid_runs then . else error("invalid recorder sequence evidence") end
  ' "$1"
}

feed_evidence() {
  jq -e '
    def epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    def current_feed_ok($name; $sampled):
      .recorderStatus.feedStatus[$name] as $feed |
      (($feed | type) == "object") and $feed.status == "ok" and
      (($feed.updated_at | type) == "string") and
      (($feed.updated_at | epoch) as $updated |
        $updated <= $sampled and $updated >= ($sampled - 300));
    (.recorderStatus.sampledAtUtc | epoch) as $sampled |
    (.hourStartUtc | epoch) as $start |
    (.hourEndUtc | epoch) as $end |
    current_feed_ok("Discovery"; $sampled) and
    current_feed_ok("PolymarketClobMarket"; $sampled) and
    current_feed_ok("PolymarketRtdsChainlink"; $sampled) and
    current_feed_ok("PolymarketRtdsBinance"; $sampled) and
    ((.continuousFeedHealth.observations | type) == "number") and
    (.continuousFeedHealth.observations | floor == . and . >= 60) and
    .continuousFeedHealth.unhealthyObservations == 0 and
    .continuousFeedHealth.essentialFeedErrors == 0 and
    ((.continuousFeedHealth.maxGapSeconds | type) == "number") and
    (.continuousFeedHealth.maxGapSeconds >= 0 and .continuousFeedHealth.maxGapSeconds <= 75) and
    ((.continuousFeedHealth.firstObservationUtc | epoch) as $first |
      $first >= $start and $first <= ($start + 60)) and
    ((.continuousFeedHealth.lastObservationUtc | epoch) as $last |
      $last >= ($end - 60) and $last < $end)
  ' "$1" >/dev/null
}


text_sha() { printf '%s\n' "$1" | sha256sum | awk '{printf "sha256:%s\n", $1}'; }

