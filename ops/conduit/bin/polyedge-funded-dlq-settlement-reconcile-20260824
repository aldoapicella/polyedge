  || die 'embedded probe contains a prohibited mutation API'
"$podman" exec polyedge-funded-signer node --input-type=module -e "$node_program" "$expected_evidence" "$expected_dlq" >"$probe_file"
secure_file "$probe_file" 600 131072 || die 'probe output is unsafe'
validate_probe "$probe_file" || die 'read-only DLQ and durable evidence probe failed validation'
incident_snapshot >"$incident_file"
secure_file "$incident_file" 600 65536 || die 'incident snapshot is unsafe'
after=$(queue_snapshot)
[ "$after" = "$before" ] || die 'queue changed during the read-only attestation'

/usr/bin/jq -n --arg generated "$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg helper "sha256:$(sha "$0")" --argjson expected "$expected_evidence" --argjson dlq "$expected_dlq" \
  --argjson before "$before" --argjson after "$after" --argjson heartbeat "$heartbeat" \
  --slurpfile probe "$probe_file" --slurpfile incidents "$incident_file" '
    {schema:"polyedge.funded_dlq_settlement_reconciliation.v1",
     status:"attested_durable_completion_no_duplicate_execution",generatedAtUtc:$generated,
     helperSha256:$helper,messageIds:[$expected[].message.messageId],queueBefore:$before,queueAfter:$after,
     authorizedDeadLetterBaseline:$dlq,incidents:$incidents[0],durableEvidence:$probe[0].evidence,
     safety:{openOrders:$heartbeat.openOrders,unresolvedPositions:$heartbeat.unresolvedPositions,
       unresolvedRiskReservations:$heartbeat.unresolvedRiskReservations,
       durableRiskIndexUnresolvedReservations:$probe[0].riskIndexUnresolvedCount,
       heartbeatInvocationId:$heartbeat.invocationId,heartbeatContainerId:$heartbeat.containerId,
       heartbeatCapturedAtEpoch:$heartbeat.capturedAtEpoch,safetySnapshotCacheAgeMs:$heartbeat.safetySnapshotCacheAgeMs},
     duplicateExecutionEvidence:{matchingDlqMessages:$probe[0].dlq.matchingMessages,immutableAuthorizations:3,
       immutableCompletions:3,terminalReservations:3,orderLifecycles:$probe[0].orderLifecycleMatches,
       distinctOrderIds:$probe[0].distinctOrderIds},brokerOperations:$probe[0].brokerOperations,
     mutationOperations:$probe[0].mutationOperations,remoteStateMutationPerformed:false,
     parityTimerRemainsPaused:true,azureDeletionAllowed:false}' >"$receipt_tmp"
