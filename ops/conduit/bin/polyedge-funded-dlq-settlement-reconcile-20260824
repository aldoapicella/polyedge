if [ "${POLYEDGE_TEST_ALLOW_UNPRIVILEGED:-}" = 1 ]; then
  receipt_root=${POLYEDGE_TEST_RECEIPT_ROOT:?}; receipt=${POLYEDGE_TEST_RECEIPT:?}
  lock_file=${POLYEDGE_TEST_LOCK_FILE:?}; runtime_dir=${POLYEDGE_TEST_RUNTIME_DIR:?}
