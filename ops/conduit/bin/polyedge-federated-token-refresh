#!/bin/sh
set -eu

lane=${1:?usage: polyedge-federated-token-refresh LANE DESTINATION ISSUER}
destination=${2:?usage: polyedge-federated-token-refresh LANE DESTINATION ISSUER}
issuer=${3:?usage: polyedge-federated-token-refresh LANE DESTINATION ISSUER}
audience=api://AzureADTokenExchange
socket=${SPIRE_AGENT_SOCKET:-/run/spire/agent.sock}
spire_agent=${SPIRE_AGENT_BIN:-/opt/spire/bin/spire-agent}
token_root=${POLYEDGE_FEDERATED_TOKEN_ROOT:-/run}

case "$lane" in
  api|research|shadow-qset|funded-signer) ;;
  *) echo 'unknown identity lane' >&2; exit 64 ;;
esac
subject=spiffe://polyedge.local/conduit/$lane
expected_destination=$token_root/polyedge-federated-$lane/azure-federated-token
[ "$destination" = "$expected_destination" ] || {
  echo 'token destination does not match the identity lane' >&2
  exit 64
}
case "$issuer" in
  https://*) ;;
  *) echo 'OIDC issuer must use HTTPS' >&2; exit 64 ;;
esac
test -S "$socket" || { echo 'SPIRE Workload API socket is unavailable' >&2; exit 1; }
test -x "$spire_agent" || { echo 'SPIRE Agent binary is unavailable' >&2; exit 1; }

temporary=$(mktemp "$destination.XXXXXX")
trap 'unlink "$temporary" 2>/dev/null || true' EXIT HUP INT TERM
"$spire_agent" api fetch jwt \
  -socketPath "$socket" \
  -spiffeID "$subject" \
  -audience "$audience" \
  -output json \
  | jq -erj --arg subject "$subject" \
      '[.svids[] | select((.spiffeId // .spiffe_id) == $subject) | .svid]
       | if length == 1 then .[0] else error("expected one JWT-SVID") end' \
      > "$temporary"
chmod 0600 "$temporary"

python3 - "$temporary" "$issuer" "$subject" "$audience" <<'PY'
import base64
import json
import sys
import time

path, issuer, subject, audience = sys.argv[1:]
with open(path, "rb") as token_file:
    token = token_file.read()
if not 0 < len(token) <= 16 * 1024 or b"\x00" in token:
    raise SystemExit("JWT-SVID size is invalid")
parts = token.rstrip(b"\r\n").split(b".")
if len(parts) != 3 or any(not part for part in parts):
    raise SystemExit("JWT-SVID shape is invalid")

def decode(part):
    return json.loads(base64.urlsafe_b64decode(part + b"=" * (-len(part) % 4)))

try:
    header = decode(parts[0])
    claims = decode(parts[1])
except Exception:
    raise SystemExit("JWT-SVID claims are invalid") from None
now = int(time.time())
issued = claims.get("iat")
expires = claims.get("exp")
valid_audience = claims.get("aud") in (audience, [audience])
if (
    header.get("alg") != "RS256"
    or claims.get("iss") != issuer
    or claims.get("sub") != subject
    or not valid_audience
    or not isinstance(issued, int)
    or not isinstance(expires, int)
    or issued > now + 30
    or expires <= now
    or not 0 < expires - issued <= 360
):
    raise SystemExit("JWT-SVID trust claims are invalid")
PY

mv "$temporary" "$destination"
trap - EXIT HUP INT TERM
