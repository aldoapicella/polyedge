#!/usr/bin/env bash
set -euo pipefail
umask 027

readonly window=2026-08-24T08:00:00Z
readonly window_epoch=1787558400
readonly old_ledger=/srv/polyedge-ring/parity/20260821T200000Z-funded-active.json
readonly ledger=/srv/polyedge-ring/parity/20260824T080000Z-funded-active.json
readonly formal=/etc/polyedge/parity-hourly.env
readonly hourly=/etc/polyedge/jobs/hourly.env
readonly old_formal_sha=41b0cbbd22adcb872a8005a1b9f5502733ad7c7bcf11ad160eb1d1e1d25cb8c8
readonly old_hourly_sha=5a6b85b8ae29a62603e902e3da10e184c4d9c71a78cc8790b6426f79dd61059b
readonly old_ledger_sha=2e2930f4d4665f9ed9c73dba32f22c8bcd368605d9726bf5f46b78019804a1a5
readonly recovery_script=/usr/local/libexec/polyedge-funded-reservation-recovery-20260824
readonly recovery_script_sha=8ec3b59df15f3d6b2c8e55687f1b064bbf8af793231486063ec8a073b0bed8b4
readonly recovery=/srv/polyedge-ring/parity/funded-recovery/20260824T052321Z-acknowledged-evicted-no-fill.json
readonly settlement=/srv/polyedge-ring/parity/funded-recovery/20260824T060435Z-settlement-loss-dlq-1311.json
readonly rollout=/srv/polyedge-ring/parity/activation/20260824T060435Z-funded-signer-rollout.json
readonly recovery_receipt_sha=sha256:925dbb659f4f2da877d3321b8165e2f6d8157d1d2d81e9fc2a62e7bc72bccee0
readonly settlement_receipt_sha=sha256:f4cfa78ff7dbb63f401ef1f4f427fb6a2d9a1d9b2d96e96476b69264313570ee
readonly authorized_dlq=1311
readonly rollback=/etc/polyedge/rollback/20260824T080000Z-funded-active
readonly transaction=$rollback/env-transaction.json
readonly activation_dir=/srv/polyedge-ring/parity/activation
readonly receipt=$activation_dir/20260824T080000Z-staged.json
readonly first_validated=$activation_dir/20260824T080000Z-first-hour-validated.json
readonly first_evidence=/srv/polyedge-ring/parity/hourly/20260824T08/evidence.json
readonly old_signer_image=ghcr.io/aldoapicella/polyedge-venue-probe@sha256:212a34d97075ff74b57681aff65e49913431e6caf2f7c015104102c62837e6f3
readonly producer_image=ghcr.io/aldoapicella/polyedge-rust-backend@sha256:9eb1b04b01b131bd440bb956c8784e8e493a6e03fe4f03aeb27142284c6fcba8
readonly recovery_image=ghcr.io/aldoapicella/polyedge-venue-probe@sha256:212a34d97075ff74b57681aff65e49913431e6caf2f7c015104102c62837e6f3
readonly decision=65b559290100796ef9137179176bf053c8ab5421a1ef3c80bd8fd81676611de7
readonly run=funded-direct-20260822235002541-68c5aaa9
readonly order=0xd9b1491affbcc71b3876763af5583411b05e08ef8b46a74a88d983dbea1a9319
readonly reservation_blob=reports/research/venue-probe/risk-reservations/2026-08-22/funded-direct-65b559290100796ef9137179176bf053c8ab5421a1ef3c80bd8fd81676611de7.json
readonly reservation_sha=sha256:e32a1ec82254c5490f0c25a25d2fed99fe3ab129002610234c704ef688a24a9d
readonly completion_blob=reports/funded/dynamic-quote/sessions/dynamic-quote-funded-2026-08-13-v10/completed/65b559290100796ef9137179176bf053c8ab5421a1ef3c80bd8fd81676611de7.json
readonly completion_sha=sha256:fcc2f5861c5364202bd171b4b229e883472980f1db752ab7588bdba1d2f3bed9
readonly summary_blob=reports/research/venue-probe/runs/2026-08-22/funded-direct-20260822235002541-68c5aaa9/summary.json
readonly summary_sha=sha256:a5ea76b54d8b3b9b3fa4ae5d549de6466d0eae1c22d4ca4074b362ec0c725d57
readonly subscription=73783c0c-5a53-4f9b-b244-6f64e813814c
readonly resource_group=rg-polyedge-dev
readonly namespace=sb-polyedge-funded-cl-6urdjr5nmwx7w
readonly queue=funded-dynamic-quote-intents
readonly collector=/usr/local/libexec/polyedge-parity-hourly
readonly collector_sha=sha256:6af251be658005fd9a9803f4193d2e489ac46cadd7e14299649b3627948d3ed3
readonly validator=/usr/local/libexec/polyedge-reboot-attestation
readonly validator_sha=sha256:06afbf3330085179a90bfd6b16c448f618389f0e77f5516028ec4d22c3a69bfe

formal_tmp=
hourly_tmp=
ledger_tmp=
journal_tmp=
receipt_tmp=
complete=false
mutations_started=false

sha() { /usr/bin/sha256sum "$1" | /usr/bin/cut -d' ' -f1; }

secure_file() {
  local path=$1 mode=$2 max=$3 uid gid actual links size
  test ! -L "$path" && test -f "$path"
  read -r uid gid actual links size < <(/usr/bin/stat -c '%u %g %a %h %s' "$path")
  test "$uid:$gid:$actual:$links" = "0:0:$mode:1"
  test "$size" -gt 0 && test "$size" -le "$max"
}

env_value() {
  local key=$1 path=$2 count
  count=$(/usr/bin/grep -c "^${key}=" "$path" || true)
  test "$count" = 1
  /usr/bin/awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print}' "$path"
}

validate_rollout_receipt() {
  local recovery_path=${1:-$recovery} rollout_path=${2:-$rollout} settlement_path=${3:-$settlement} receipt_sha recovery_sha settlement_sha
  receipt_sha="sha256:$(sha "$rollout_path")"
  recovery_sha="sha256:$(sha "$recovery_path")"
  settlement_sha="sha256:$(sha "$settlement_path")"
  /usr/bin/jq -e --arg old "$old_signer_image" --arg recovery "$recovery_path" --arg recovery_sha "$recovery_sha" \
    --arg settlement "$settlement_path" --arg settlement_sha "$settlement_sha" --argjson dlq "$authorized_dlq" '
      .schema == "polyedge.funded_signer_post_recovery_rollout.v1" and .status == "validated" and
      .oldImage == $old and .newImage != $old and
      (.newImage | test("^ghcr\\.io/aldoapicella/polyedge-venue-probe@sha256:[0-9a-f]{64}$")) and
      (.newRevision | test("^[0-9a-f]{40}$")) and
      .recoveryReceipt == {path:$recovery,sha256:$recovery_sha} and
      .settlementReceipt == {path:$settlement,sha256:$settlement_sha} and
      .authorizedDeadLetterBaseline == $dlq and
      (.runtime.newInvocationId | test("^[0-9a-f]{32}$")) and
      (.runtime.newContainerId | test("^[0-9a-f]{64}$")) and
      (.runtime.producerInvocationId | test("^[0-9a-f]{32}$")) and
      .producerRestored == true and .unresolvedReservationsAfter == 0 and
      .queue == {status:"Active",activeMessageCount:0,scheduledMessageCount:0,deadLetterMessageCount:$dlq} and
      .parityTimerRemainsPaused == true and .azureDeletionAllowed == false
    ' "$rollout_path" >/dev/null || return 1
  signer_image=$(/usr/bin/jq -r '.newImage' "$rollout_path")
  signer_revision=$(/usr/bin/jq -r '.newRevision' "$rollout_path")
  rollout_signer_invocation=$(/usr/bin/jq -r '.runtime.newInvocationId' "$rollout_path")
  rollout_signer_container=$(/usr/bin/jq -r '.runtime.newContainerId' "$rollout_path")
  rollout_producer_invocation=$(/usr/bin/jq -r '.runtime.producerInvocationId' "$rollout_path")
  rollout_sha=$receipt_sha
  service_bus_dlq=$authorized_dlq
}

validate_recovery_receipt() {
  local recovery_path=${1:-$recovery} cutover_epoch
  /usr/bin/jq -e --arg decision "$decision" --arg run "$run" --arg order "$order" --arg recoveryImage "$recovery_image" --arg producerImage "$producer_image" --arg reservationBlob "$reservation_blob" --arg reservationSha "$reservation_sha" --arg completionBlob "$completion_blob" --arg completionSha "$completion_sha" --arg summaryBlob "$summary_blob" --arg summarySha "$summary_sha" '
    .schema == "polyedge.acknowledged_no_fill_reconciliation.v1" and
    .status == "finalized_no_fill" and .decision_id == $decision and .run_id == $run and .order_id == $order and
    .order_submission_attempted == true and .recovery_order_submission_attempted == false and
    .recovery_grant_consumed == false and .recovery_risk_reservation_created == false and
    .reconciliation_reason == "acknowledged_evicted_order_no_fill" and .evidence.observation_ms >= 10000 and
    .recoveryImage == $recoveryImage and .signerImageUnchanged == $recoveryImage and
    .producerImageUnchanged == $producerImage and
    .reservationEvidence == {blob:$reservationBlob,sha256:$reservationSha} and
    .completionEvidence == {blob:$completionBlob,sha256:$completionSha} and
    .summaryEvidence == {blob:$summaryBlob,sha256:$summarySha} and
    .unresolvedReservationsAfter == 0 and .queueActiveMessages == 0 and .queueScheduledMessages == 0 and
    (.queueDeadLetterMessages | type == "number" and floor == . and . >= 0) and
    .parityTimerRemainsPaused == true and .azureDeletionAllowed == false and
    (.cutoverCompletedAtUtc | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
  ' "$recovery_path" >/dev/null || return 1
  cutover_epoch=$(/usr/bin/date -u -d "$(/usr/bin/jq -r '.cutoverCompletedAtUtc' "$recovery_path")" +%s) || return 1
  test "$cutover_epoch" -ge 1787549001 && test "$cutover_epoch" -lt "$window_epoch"
}

transaction_uid=${POLYEDGE_TEST_UID:-0}
transaction_gid=${POLYEDGE_TEST_GID:-0}

write_env_transaction() {
  local marker=$1 phase=$2 formal_path=$3 hourly_path=$4 before_formal=$5 before_hourly=$6 candidate_formal=$7 candidate_hourly=$8 tmp marker_dir
  marker_dir=${marker%/*}
  tmp=$(/usr/bin/mktemp "${marker}.XXXXXX") || return 1
  /usr/bin/jq -n --arg phase "$phase" --arg formal "$formal_path" --arg hourly "$hourly_path" \
    --arg before_formal "sha256:$(sha "$before_formal")" --arg before_hourly "sha256:$(sha "$before_hourly")" \
    --arg candidate_formal "sha256:$(sha "$candidate_formal")" --arg candidate_hourly "sha256:$(sha "$candidate_hourly")" '
    {schema:"polyedge.parity_env_transaction.v1",phase:$phase,
     formal:{path:$formal,beforeSha256:$before_formal,candidateSha256:$candidate_formal},
     hourly:{path:$hourly,beforeSha256:$before_hourly,candidateSha256:$candidate_hourly}}
  ' >"$tmp" || { /usr/bin/rm -f "$tmp"; return 1; }
  /usr/bin/chown "$transaction_uid:$transaction_gid" "$tmp" &&
    /usr/bin/chmod 0600 "$tmp" && /usr/bin/sync -f "$tmp" &&
    /usr/bin/mv -f "$tmp" "$marker" && /usr/bin/sync -f "$marker_dir"
}

validate_env_transaction() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7
  test ! -L "$marker" && test -f "$marker" || return 1
  test "$(/usr/bin/stat -c '%u:%g:%a:%h' "$marker")" = "$transaction_uid:$transaction_gid:600:1" || return 1
  /usr/bin/jq -e --arg formal "$formal_path" --arg hourly "$hourly_path" \
    --arg before_formal "sha256:$(sha "$before_formal")" --arg before_hourly "sha256:$(sha "$before_hourly")" \
    --arg candidate_formal "sha256:$(sha "$candidate_formal")" --arg candidate_hourly "sha256:$(sha "$candidate_hourly")" '
    .schema == "polyedge.parity_env_transaction.v1" and
    (.phase | test("^(prepared|formal_moved|committed|recovering|formal_restored|recovered_before)$")) and
    .formal == {path:$formal,beforeSha256:$before_formal,candidateSha256:$candidate_formal} and
    .hourly == {path:$hourly,beforeSha256:$before_hourly,candidateSha256:$candidate_hourly}
  ' "$marker" >/dev/null
}

restore_before_pair() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7 formal_restore hourly_restore
  formal_restore=$(/usr/bin/mktemp "${formal_path}.XXXXXX") || return 1
  hourly_restore=$(/usr/bin/mktemp "${hourly_path}.XXXXXX") || { /usr/bin/rm -f "$formal_restore"; return 1; }
  /usr/bin/install -o "$transaction_uid" -g "$transaction_gid" -m 0640 "$before_formal" "$formal_restore" &&
    /usr/bin/install -o "$transaction_uid" -g "$transaction_gid" -m 0600 "$before_hourly" "$hourly_restore" &&
    /usr/bin/sync -f "$formal_restore" && /usr/bin/sync -f "$hourly_restore" &&
    write_env_transaction "$marker" recovering "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" &&
    /usr/bin/mv -f "$formal_restore" "$formal_path" &&
    write_env_transaction "$marker" formal_restored "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" &&
    /usr/bin/mv -f "$hourly_restore" "$hourly_path" &&
    write_env_transaction "$marker" recovered_before "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
}

recover_env_transaction() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7 prefer=$8 formal_sha hourly_sha before_formal_sha before_hourly_sha candidate_formal_sha candidate_hourly_sha
  test -e "$marker" || return 0
  validate_env_transaction "$marker" "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" || return 1
  formal_sha="sha256:$(sha "$formal_path")"
  hourly_sha="sha256:$(sha "$hourly_path")"
  before_formal_sha="sha256:$(sha "$before_formal")"
  before_hourly_sha="sha256:$(sha "$before_hourly")"
  candidate_formal_sha="sha256:$(sha "$candidate_formal")"
  candidate_hourly_sha="sha256:$(sha "$candidate_hourly")"
  if test "$formal_sha" = "$before_formal_sha" && test "$hourly_sha" = "$before_hourly_sha"; then
    write_env_transaction "$marker" recovered_before "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
  elif test "$formal_sha" = "$candidate_formal_sha" && test "$hourly_sha" = "$candidate_hourly_sha"; then
    if test "$prefer" = before; then
      restore_before_pair "$marker" "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
    else
      write_env_transaction "$marker" committed "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
    fi
  elif { test "$formal_sha" = "$candidate_formal_sha" && test "$hourly_sha" = "$before_hourly_sha"; } ||
       { test "$formal_sha" = "$before_formal_sha" && test "$hourly_sha" = "$candidate_hourly_sha"; }; then
    restore_before_pair "$marker" "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
  else
    return 1
  fi
}

commit_candidate_pair() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7 formal_source=$8 hourly_source=$9
  write_env_transaction "$marker" prepared "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" &&
    /usr/bin/mv -f "$formal_source" "$formal_path" &&
    write_env_transaction "$marker" formal_moved "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" || return 1
  if test "${POLYEDGE_TEST_KILL_BETWEEN_ENV_MOVES:-0}" = 1; then /usr/bin/kill -KILL "${BASHPID:-$$}"; fi
  /usr/bin/mv -f "$hourly_source" "$hourly_path" &&
    write_env_transaction "$marker" committed "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
}
render_env() {
  local source=$1 target=$2 key count
  shift 2
  for key in "$@"; do
    count=$(/usr/bin/grep -c "^${key}=" "$source" || true)
    test "$count" -le 1 || return 1
  done
  /usr/bin/awk '
    /^(POLYEDGE_PARITY_WINDOW_START_UTC|POLYEDGE_PARITY_LEDGER|POLYEDGE_PARITY_FUNDED_MODE|POLYEDGE_PARITY_EXPECTED_FUNDED_IMAGE|POLYEDGE_PARITY_EXPECTED_FUNDED_REVISION|POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT|POLYEDGE_PARITY_EXPECTED_FUNDED_ROLLOUT_RECEIPT_SHA256|POLYEDGE_PARITY_FUNDED_UID|POLYEDGE_PARITY_FUNDED_GID|POLYEDGE_PARITY_EXPECTED_FUNDED_SESSION_ID|POLYEDGE_PARITY_EXPECTED_FUNDED_SESSION_SHA256|POLYEDGE_PARITY_EXPECTED_FUNDED_CONFIG_SHA256|POLYEDGE_PARITY_EXPECTED_FUNDED_PRODUCER_IMAGE|POLYEDGE_PARITY_EXPECTED_FUNDED_PRODUCER_CONFIG_SHA256|POLYEDGE_PARITY_EXPECTED_FUNDED_SERVICE_BUS_DLQ|POLYEDGE_PARITY_EXPECTED_COLLECTOR_SHA256|POLYEDGE_PARITY_EXPECTED_REBOOT_VALIDATOR_SHA256)=/ {next}
    {print}
  ' "$source" >"$target"
  {
    printf 'POLYEDGE_PARITY_WINDOW_START_UTC=%s\n' "$window"
    printf 'POLYEDGE_PARITY_LEDGER=%s\n' "$ledger"
    printf 'POLYEDGE_PARITY_FUNDED_MODE=active\n'
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_IMAGE=%s\n' "$signer_image"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_REVISION=%s\n' "$signer_revision"
    printf 'POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT=%s\n' "$rollout"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_ROLLOUT_RECEIPT_SHA256=%s\n' "$rollout_sha"
    printf 'POLYEDGE_PARITY_FUNDED_UID=%s\n' "$funded_uid"
    printf 'POLYEDGE_PARITY_FUNDED_GID=%s\n' "$funded_gid"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_SESSION_ID=%s\n' "$funded_session"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_SESSION_SHA256=%s\n' "$funded_session_sha"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_CONFIG_SHA256=%s\n' "$funded_config_sha"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_PRODUCER_IMAGE=%s\n' "$funded_producer_image"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_PRODUCER_CONFIG_SHA256=%s\n' "$funded_producer_config_sha"
    printf 'POLYEDGE_PARITY_EXPECTED_FUNDED_SERVICE_BUS_DLQ=%s\n' "$service_bus_dlq"
    printf 'POLYEDGE_PARITY_EXPECTED_COLLECTOR_SHA256=%s\n' "$collector_sha"
    printf 'POLYEDGE_PARITY_EXPECTED_REBOOT_VALIDATOR_SHA256=%s\n' "$validator_sha"
  } >>"$target"
  for key in "$@"; do test "$(/usr/bin/grep -c "^${key}=" "$target")" = 1 || return 1; done
}

if [ "${POLYEDGE_TEST_SOURCE_ONLY:-}" = 1 ]; then return 0; fi

token_fresh() {
  local path=$1 expected=$2 uid gid mode links mtime age
  test ! -L "$path" && test -f "$path"
  read -r uid gid mode links mtime < <(/usr/bin/stat -c '%u %g %a %h %Y' "$path")
  test "$uid:$gid:$mode:$links" = "$expected"
  age=$(( $(/usr/bin/date -u +%s) - mtime ))
  test "$age" -ge 0 && test "$age" -le 240
}

restore_bindings() {
  local rc=$?
  trap - EXIT HUP INT TERM
  /usr/bin/rm -f "$formal_tmp" "$hourly_tmp" "$ledger_tmp" "$journal_tmp" "$receipt_tmp"
  if [ "$complete" != true ] && [ "$mutations_started" = true ]; then
    /usr/bin/systemctl disable --now polyedge-parity-hourly.timer >/dev/null 2>&1 || true
    if [ -f "$transaction" ] && [ -f "$rollback/parity-hourly.env.candidate" ] && [ -f "$rollback/hourly.env.candidate" ]; then
      restore_before_pair "$transaction" "$formal" "$hourly" "$rollback/parity-hourly.env.before" \
        "$rollback/hourly.env.before" "$rollback/parity-hourly.env.candidate" "$rollback/hourly.env.candidate" || true
    fi
    /usr/bin/logger -p daemon.err -t polyedge-parity-activation "stage failed closed rc=$rc; previous bindings restored"
  fi
  exit "$rc"
}
trap restore_bindings EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

test "$(/usr/bin/id -u)" -eq 0
exec 9>/run/polyedge/utility.lock
/usr/bin/flock -n 9 || { echo 'another PolyEdge utility is active' >&2; exit 75; }

secure_file "$collector" 755 262144
secure_file "$validator" 755 262144
secure_file "$recovery" 640 65536
secure_file "$settlement" 640 65536
secure_file "$rollout" 640 65536
secure_file "$recovery_script" 700 65536
test "sha256:$(sha "$collector")" = "$collector_sha"
test "sha256:$(sha "$validator")" = "$validator_sha"
test "$(sha "$recovery_script")" = "$recovery_script_sha"
test "sha256:$(sha "$recovery")" = "$recovery_receipt_sha"
test "sha256:$(sha "$settlement")" = "$settlement_receipt_sha"
validate_recovery_receipt
validate_rollout_receipt
test "$(/usr/bin/podman inspect --format '{{.Config.Image}}|{{.Config.User}}|{{.State.Status}}' polyedge-funded-signer)" = "$signer_image|986:982|running"
test "$(/usr/bin/podman image inspect --format '{{.Os}}/{{.Architecture}}|{{ index .Labels "org.opencontainers.image.revision" }}' "$signer_image")" = "linux/arm64|$signer_revision"
queue_json=$(/usr/sbin/runuser -u ubuntu -- /usr/bin/az servicebus queue show --subscription "$subscription" --resource-group "$resource_group" --namespace-name "$namespace" --name "$queue" --only-show-errors -o json)
/usr/bin/jq -e --argjson dlq "$service_bus_dlq" '.status == "Active" and
  .countDetails.activeMessageCount == 0 and .countDetails.scheduledMessageCount == 0 and
  .countDetails.deadLetterMessageCount == $dlq' <<<"$queue_json" >/dev/null

if [ -e "$first_validated" ]; then
  if (
    secure_file "$first_validated" 640 65536 || exit 1
    secure_file "$receipt" 640 65536 || exit 1
    secure_file "$first_evidence" 640 1048576 || exit 1
    secure_file "$ledger" 640 1048576 || exit 1
    secure_file "$formal" 640 1048576 || exit 1
    secure_file "$hourly" 600 1048576 || exit 1
    evidence_sha="sha256:$(sha "$first_evidence")" || exit 1
    /usr/bin/jq -e --arg window "$window" --arg ledger "$ledger" --arg evidence "$first_evidence" --arg evidence_sha "$evidence_sha" \
      --arg collector "$collector_sha" --arg validator "$validator_sha" '
      .schemaVersion == 1 and .status == "validated" and .windowStartUtc == $window and
      .ledger.path == $ledger and .evidence.path == $evidence and .evidence.sha256 == $evidence_sha and
      .acceptedCleanLiveHours == 1 and .collectorSha256 == $collector and .validatorSha256 == $validator and
      .azureAuthoritative == true and .azureDeletionAllowed == false
    ' "$first_validated" >/dev/null || exit 1
    /usr/bin/jq -e --arg window "$window" --arg evidence "$first_evidence" --arg evidence_sha "$evidence_sha" '
      .windowStartUtc == $window and .acceptedCleanLiveHours >= 1 and
      (.acceptedHourlyEvidence | length) == .acceptedCleanLiveHours and
      .acceptedHourlyEvidence[0].hourStartUtc == $window and
      .acceptedHourlyEvidence[0].path == $evidence and .acceptedHourlyEvidence[0].sha256 == $evidence_sha and
      .azureAuthoritative == true and .azureDeletionAllowed == false and
      .shadowQsetEnabled == false and .fundedSignerEnabled == true and .fundedIntentProducerEnabled == true
    ' "$ledger" >/dev/null || exit 1
    test "$(sha "$formal")" = "$(/usr/bin/jq -r '.bindings.formalSha256' "$receipt" | /usr/bin/cut -d: -f2)" || exit 1
    test "$(sha "$hourly")" = "$(/usr/bin/jq -r '.bindings.hourlySha256' "$receipt" | /usr/bin/cut -d: -f2)" || exit 1
    POLYEDGE_PARITY_ENV_FILE="$formal" "$validator" validate-ledger || exit 1
    ! /usr/bin/systemctl is-enabled --quiet polyedge-parity-hourly.timer || exit 1
    ! /usr/bin/systemctl is-active --quiet polyedge-parity-hourly.timer || exit 1
  ); then
    complete=true
    trap - EXIT HUP INT TERM
    exit 0
  fi
  complete=true
  /usr/bin/logger -p daemon.err -t polyedge-parity-activation 'terminal stage-one rerun found inconsistent accepted parity state; no mutation performed'
  trap - EXIT HUP INT TERM
  exit 1
fi

