    .schema == "polyedge.funded_signer_post_redemption_attestation.v1" and .status == "attested" and
    .helperSha256 == $helper and .authorizedDeadLetterBaseline == $dlq and
    .runtime.signer.invocationId == $signer_invocation and .runtime.signer.containerId == $signer_container and
    .runtime.signer.restartCount == 0 and .runtime.signer.image == $image and .runtime.signer.revision == $revision and
    .runtime.signer.user == "986:982" and
    .runtime.producer.invocationId == $producer_invocation and .runtime.producer.containerId == $producer_container and
    .runtime.producer.restartCount == 0 and .runtime.producer.image == $producer_image and
    .runtime.producer.revision == $producer_revision and .runtime.producer.user == "984:980" and
    .runtime.producer.status == "running" and .runtime.producer.health == "healthy" and
    (.redemption.transactionHash | test("^0x[0-9a-f]{64}$")) and
