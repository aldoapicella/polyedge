set -euo pipefail
umask 027

readonly window=2026-08-24T21:00:00Z
readonly collect_not_before=1787609880
readonly enable_deadline=1787612400
readonly ledger=/srv/polyedge-ring/parity/20260824T210000Z-funded-active.json
readonly evidence=/srv/polyedge-ring/parity/hourly/20260824T21/evidence.json
readonly formal=/etc/polyedge/parity-hourly.env
readonly hourly=/etc/polyedge/jobs/hourly.env
readonly rollback=/etc/polyedge/rollback/20260824T210000Z-funded-active
readonly transaction=$rollback/env-transaction.json
readonly staged=/srv/polyedge-ring/parity/activation/20260824T210000Z-staged.json
readonly validated=/srv/polyedge-ring/parity/activation/20260824T210000Z-first-hour-validated.json
readonly recovery=/srv/polyedge-ring/parity/funded-recovery/20260824T052321Z-acknowledged-evicted-no-fill.json
readonly settlement=/srv/polyedge-ring/parity/funded-recovery/20260824T060435Z-settlement-loss-dlq-1311.json
readonly rollout=/srv/polyedge-ring/parity/activation/20260824T203004Z-post-restart-redemption-attestation.json
readonly rollout_receipt_sha=sha256:6a5e7660460f13f86288107bdadc3fef1df15d6431e9f3eea408e0c20b943380
readonly rollout_helper_sha=sha256:b0588df04a92eb58d1e8727d61ef9a0b2ab8935336327f612ac89e7f455c27ab
readonly recovery_receipt_sha=sha256:925dbb659f4f2da877d3321b8165e2f6d8157d1d2d81e9fc2a62e7bc72bccee0
readonly settlement_receipt_sha=sha256:f4cfa78ff7dbb63f401ef1f4f427fb6a2d9a1d9b2d96e96476b69264313570ee
readonly authorized_dlq=1339
readonly signer_invocation_expected=36f0fc2fae7c43e4a7a234f2a4f546c7
readonly signer_container_expected=fde5a0ded60daa5fec75dd6e6407b660cd211ab83c081896ce56575fa192d805
readonly producer_image_expected=ghcr.io/aldoapicella/polyedge-rust-backend@sha256:9eb1b04b01b131bd440bb956c8784e8e493a6e03fe4f03aeb27142284c6fcba8
readonly producer_revision_expected=72224c12d0790c02d98be7ece8fbcb781b6412e4
readonly producer_invocation_expected=2d2b45a9f25a4ee58a9938f75c6d1710
readonly producer_container_expected=052fb251a198aa88510b084692cd7c1e8260b08035e091ba08f4366757ccb2a7
readonly collector=/usr/local/libexec/polyedge-parity-hourly
readonly collector_sha=sha256:ac0bdebb8ed312e3b75419e437b432e88389dc7f150522ec10ec5bdd860b682f
readonly validator=/usr/local/libexec/polyedge-reboot-attestation
readonly validator_sha=sha256:313725793e3b261c760acf3ecb300f5a5c96c51473cd8e94383731049ea2f099
readonly subscription=73783c0c-5a53-4f9b-b244-6f64e813814c
readonly resource_group=rg-polyedge-dev
readonly namespace=sb-polyedge-funded-cl-6urdjr5nmwx7w
readonly queue=funded-dynamic-quote-intents
readonly producer_env_binding_sha=sha256:8faa07c90246486bcd9e609924d85368a1e69ad85ca6961bb45af22ee46bbb9b
readonly producer_mount_binding_sha=sha256:8f5f4dcf132460eed131e7a0d096d54d1cb1f972b8bd5b279700021ac1bc698e
readonly old_formal_sha=d67873339d719b1221b9e3de7057dc78ca9cda2d483a512e41ac02dbfa2574e9
