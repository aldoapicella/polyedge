test "$(/usr/bin/podman inspect --format '{{.Id}}' polyedge-funded-intent-producer)" = "$rollout_producer_container"
test "$(/usr/bin/podman image inspect --format '{{ index .Labels \"org.opencontainers.image.revision\" }}' "$producer_image_expected")" = "$producer_revision_expected"
queue_json=$(/usr/sbin/runuser -u ubuntu -- /usr/bin/az servicebus queue show --subscription "$subscription" --resource-group "$resource_group" --namespace-name "$namespace" --name "$queue" --only-show-errors -o json)
/usr/bin/jq -e --argjson dlq "$POLYEDGE_PARITY_EXPECTED_FUNDED_SERVICE_BUS_DLQ" '.status == "Active" and
  .countDetails.activeMessageCount == 0 and .countDetails.scheduledMessageCount == 0 and
  .countDetails.deadLetterMessageCount == $dlq' <<<"$queue_json" >/dev/null

if [ -e "$validated" ]; then
  if (
    secure_file "$validated" 640 65536 || exit 1
    secure_file "$evidence" 640 1048576 || exit 1
    secure_file "$formal" 640 1048576 || exit 1
    secure_file "$hourly" 600 1048576 || exit 1
    evidence_sha="sha256:$(sha "$evidence")" || exit 1
    /usr/bin/jq -e --arg window "$window" --arg ledger "$ledger" --arg evidence "$evidence" --arg evidence_sha "$evidence_sha" \
      --arg collector "$collector_sha" --arg validator "$validator_sha" '
      .schemaVersion == 1 and .status == "validated" and .windowStartUtc == $window and
      .ledger.path == $ledger and .evidence.path == $evidence and .evidence.sha256 == $evidence_sha and
      .acceptedCleanLiveHours == 1 and .completedDailyCycles == 0 and
      .collectorSha256 == $collector and .validatorSha256 == $validator and .recurrenceEnabled == false and
      .azureAuthoritative == true and .azureDeletionAllowed == false
    ' "$validated" >/dev/null || exit 1
    test "$(sha "$rollback/parity-hourly.env.candidate")" = "$(/usr/bin/jq -r '.bindings.formalSha256' "$staged" | /usr/bin/cut -d: -f2)" || exit 1
    test "$(sha "$rollback/hourly.env.candidate")" = "$(/usr/bin/jq -r '.bindings.hourlySha256' "$staged" | /usr/bin/cut -d: -f2)" || exit 1
    test "$(sha "$formal")" = "$(/usr/bin/jq -r '.bindings.formalSha256' "$staged" | /usr/bin/cut -d: -f2)" || exit 1
    test "$(sha "$hourly")" = "$(/usr/bin/jq -r '.bindings.hourlySha256' "$staged" | /usr/bin/cut -d: -f2)" || exit 1
    /usr/bin/jq -e --arg window "$window" --arg evidence "$evidence" --arg evidence_sha "$evidence_sha" '
      .windowStartUtc == $window and .acceptedCleanLiveHours >= 1 and
      (.acceptedHourlyEvidence | length) == .acceptedCleanLiveHours and
      .acceptedHourlyEvidence[0].hourStartUtc == $window and
      .acceptedHourlyEvidence[0].path == $evidence and .acceptedHourlyEvidence[0].sha256 == $evidence_sha and
      .azureAuthoritative == true and .azureDeletionAllowed == false and
      .shadowQsetEnabled == false and .fundedSignerEnabled == true and .fundedIntentProducerEnabled == true
    ' "$ledger" >/dev/null || exit 1
    POLYEDGE_PARITY_ENV_FILE="$formal" "$validator" validate-ledger || exit 1
    ! /usr/bin/systemctl is-enabled --quiet polyedge-parity-hourly.timer || exit 1
    ! /usr/bin/systemctl is-active --quiet polyedge-parity-hourly.timer || exit 1
  ); then
    complete=true
    trap - EXIT HUP INT TERM
    exit 0
  fi
  complete=true
  /usr/bin/logger -p daemon.err -t polyedge-parity-activation 'terminal stage-two rerun found inconsistent accepted parity state; no mutation performed'
  trap - EXIT HUP INT TERM
  exit 1
fi

test "$(/usr/bin/date -u +%s)" -ge "$collect_not_before"
test "$(/usr/bin/date -u +%s)" -lt "$enable_deadline"
mutations_started=true
/usr/bin/systemctl disable --now polyedge-parity-hourly.timer >/dev/null
! /usr/bin/systemctl is-active --quiet polyedge-parity-hourly.timer
recover_env_transaction "$transaction" "$formal" "$hourly" "$rollback/parity-hourly.env.before" \
  "$rollback/hourly.env.before" "$rollback/parity-hourly.env.candidate" "$rollback/hourly.env.candidate" candidate
/usr/bin/jq -e --arg window "$window" --arg ledger "$ledger" '
  .schemaVersion == 1 and .status == "staged" and .windowStartUtc == $window and
  .ledger.path == $ledger and .acceptedCleanLiveHours == 0 and .completedDailyCycles == 0 and
  .rebootRecoveryPassed == false and .shadowQsetEnabled == false and
  .azureAuthoritative == true and .azureDeletionAllowed == false
' "$staged" >/dev/null
test "$(sha "$rollback/parity-hourly.env.candidate")" = "$(/usr/bin/jq -r '.bindings.formalSha256' "$staged" | /usr/bin/cut -d: -f2)"
test "$(sha "$rollback/hourly.env.candidate")" = "$(/usr/bin/jq -r '.bindings.hourlySha256' "$staged" | /usr/bin/cut -d: -f2)"

formal_tmp=$(/usr/bin/mktemp "${formal}.XXXXXX")
hourly_tmp=$(/usr/bin/mktemp "${hourly}.XXXXXX")
/usr/bin/install -o root -g root -m 0640 "$rollback/parity-hourly.env.candidate" "$formal_tmp"
/usr/bin/install -o root -g root -m 0600 "$rollback/hourly.env.candidate" "$hourly_tmp"
/usr/bin/sync -f "$formal_tmp"
/usr/bin/sync -f "$hourly_tmp"
commit_candidate_pair "$transaction" "$formal" "$hourly" "$rollback/parity-hourly.env.before" \
  "$rollback/hourly.env.before" "$rollback/parity-hourly.env.candidate" "$rollback/hourly.env.candidate" "$formal_tmp" "$hourly_tmp"
formal_tmp=
hourly_tmp=
secure_file "$formal" 640 1048576
secure_file "$hourly" 600 1048576
POLYEDGE_PARITY_ENV_FILE="$formal" "$validator" validate-ledger
/usr/local/libexec/polyedge-boot-disk-guard --assert-headroom
test ! -e /run/polyedge/image-pulls-paused

count=$(/usr/bin/jq -r '.acceptedCleanLiveHours' "$ledger")
case "$count" in
  0)
    test "$(sha "$ledger")" = "$(/usr/bin/jq -r '.ledger.sha256' "$staged" | /usr/bin/cut -d: -f2)"
    POLYEDGE_PARITY_UTILITY_LOCKED=1 POLYEDGE_PARITY_TARGET_HOUR_UTC="$window" "$collector"
    ;;
  1) ;;
  *) echo "unexpected accepted hour count: $count" >&2; exit 1 ;;
esac

secure_file "$ledger" 640 1048576
secure_file "$evidence" 640 1048576
/usr/bin/jq -e --arg window "$window" --arg evidence "$evidence" --arg collector "$collector_sha" --arg validator "$validator_sha" '
  .schemaVersion == 1 and .status == "in_progress" and .windowStartUtc == $window and
  .acceptedCleanLiveHours == 1 and (.acceptedHourlyEvidence | length) == 1 and
  .acceptedHourlyEvidence[0].hourStartUtc == $window and .acceptedHourlyEvidence[0].path == $evidence and
  (.acceptedHourlyEvidence[0].sha256 | test("^sha256:[0-9a-f]{64}$")) and
  .completedDailyCycles == 0 and .acceptedDailyEvidence == [] and
  .rebootRecoveryPassed == false and (has("rebootRecovery") | not) and
  .shadowQsetEnabled == false and .fundedSignerEnabled == true and .fundedSignerMode == "active" and
  .fundedIntentProducerEnabled == true and .parityCollectorSha256 == $collector and
  .rebootValidatorSha256 == $validator and .azureAuthoritative == true and .azureDeletionAllowed == false
' "$ledger" >/dev/null
test "sha256:$(sha "$evidence")" = "$(/usr/bin/jq -r '.acceptedHourlyEvidence[0].sha256' "$ledger")"
validate_first_hour_evidence "$evidence"

test "$(/usr/bin/date -u +%s)" -lt "$enable_deadline"
! /usr/bin/systemctl is-enabled --quiet polyedge-parity-hourly.timer
! /usr/bin/systemctl is-active --quiet polyedge-parity-hourly.timer

receipt_tmp=$(/usr/bin/mktemp /srv/polyedge-ring/parity/activation/.20260824T210000Z-first-hour.XXXXXX)
/usr/bin/jq -n --arg created "$(/usr/bin/date -u +%Y-%m-%dT%H:%M:%SZ)" --arg window "$window" \
  --arg ledger "$ledger" --arg ledgerSha "sha256:$(sha "$ledger")" --arg evidence "$evidence" \
  --arg evidenceSha "sha256:$(sha "$evidence")" --arg collectorSha "$collector_sha" --arg validatorSha "$validator_sha" '
  {schemaVersion:1,status:"validated",createdAtUtc:$created,windowStartUtc:$window,
   ledger:{path:$ledger,sha256:$ledgerSha},evidence:{path:$evidence,sha256:$evidenceSha},
   collectorSha256:$collectorSha,validatorSha256:$validatorSha,acceptedCleanLiveHours:1,completedDailyCycles:0,
   rebootRecoveryPassed:false,shadowQsetEnabled:false,recurrenceEnabled:false,
   azureAuthoritative:true,azureDeletionAllowed:false}
' >"$receipt_tmp"
/usr/bin/chown root:root "$receipt_tmp"
/usr/bin/chmod 0640 "$receipt_tmp"
/usr/bin/ln "$receipt_tmp" "$validated"
/usr/bin/rm -f "$receipt_tmp"
receipt_tmp=
complete=true
/usr/bin/logger -p daemon.info -t polyedge-parity-activation "validated first funded-active hour $window; recurring collector remains disabled"
trap - EXIT HUP INT TERM
