formal_tmp=
hourly_tmp=
receipt_tmp=
complete=false
mutations_started=false

sha() { /usr/bin/sha256sum "$1" | /usr/bin/cut -d' ' -f1; }

secure_file() {
  local path=$1 mode=$2 max=$3 uid gid actual links size
  test ! -L "$path" && test -f "$path"
  read -r uid gid actual links size < <(/usr/bin/stat -c '%u %g %a %h %s' "$path")
  test "$uid:$gid:$actual:$links" = "0:0:$mode:1"
  test "$size" -gt 0 && test "$size" -le "$max"
}

validate_staged_receipt() {
  local staged_path=${1:-$staged} recovery_path=${2:-$recovery} rollout_path=${3:-$rollout} settlement_path=${4:-$settlement}
  local staged_dlq
  staged_dlq=$(/usr/bin/jq -er '.authorizedDeadLetterBaseline' "$rollout_path")
  if test "$rollout_path" = "$rollout"; then test "$staged_dlq" = "$authorized_dlq"; fi
  /usr/bin/jq -e --arg window "$window" --arg ledger "$ledger" --arg recovery "$recovery_path" \
    --arg recovery_sha "sha256:$(sha "$recovery_path")" --arg settlement "$settlement_path" --arg settlement_sha "sha256:$(sha "$settlement_path")" \
    --argjson dlq "$staged_dlq" --arg rollout "$rollout_path" --arg rollout_sha "sha256:$(sha "$rollout_path")" \
    --arg collector "$collector_sha" --arg validator "$validator_sha" '
      .schemaVersion == 1 and .status == "staged" and .windowStartUtc == $window and
      .ledger.path == $ledger and .recovery.path == $recovery and .recovery.sha256 == $recovery_sha and
      .settlement == {path:$settlement,sha256:$settlement_sha} and .authorizedDeadLetterBaseline == $dlq and
      .rollout == {path:$rollout,sha256:$rollout_sha} and
      .bindings.collectorSha256 == $collector and .bindings.validatorSha256 == $validator and
      .acceptedCleanLiveHours == 0 and .completedDailyCycles == 0 and .rebootRecoveryPassed == false and
      .recurrenceEnabled == false and .azureAuthoritative == true and .azureDeletionAllowed == false
    ' "$staged_path" >/dev/null
}

transaction_uid=${POLYEDGE_TEST_UID:-0}
transaction_gid=${POLYEDGE_TEST_GID:-0}

write_env_transaction() {
  local marker=$1 phase=$2 formal_path=$3 hourly_path=$4 before_formal=$5 before_hourly=$6 candidate_formal=$7 candidate_hourly=$8 tmp marker_dir
  marker_dir=${marker%/*}
  tmp=$(/usr/bin/mktemp "${marker}.XXXXXX") || return 1
  /usr/bin/jq -n --arg phase "$phase" --arg formal "$formal_path" --arg hourly "$hourly_path" \
    --arg before_formal "sha256:$(sha "$before_formal")" --arg before_hourly "sha256:$(sha "$before_hourly")" \
    --arg candidate_formal "sha256:$(sha "$candidate_formal")" --arg candidate_hourly "sha256:$(sha "$candidate_hourly")" '
    {schema:"polyedge.parity_env_transaction.v1",phase:$phase,
     formal:{path:$formal,beforeSha256:$before_formal,candidateSha256:$candidate_formal},
     hourly:{path:$hourly,beforeSha256:$before_hourly,candidateSha256:$candidate_hourly}}
  ' >"$tmp" || { /usr/bin/rm -f "$tmp"; return 1; }
  /usr/bin/chown "$transaction_uid:$transaction_gid" "$tmp" &&
    /usr/bin/chmod 0600 "$tmp" && /usr/bin/sync -f "$tmp" &&
    /usr/bin/mv -f "$tmp" "$marker" && /usr/bin/sync -f "$marker_dir"
}

validate_env_transaction() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7
  test ! -L "$marker" && test -f "$marker" || return 1
  test "$(/usr/bin/stat -c '%u:%g:%a:%h' "$marker")" = "$transaction_uid:$transaction_gid:600:1" || return 1
  /usr/bin/jq -e --arg formal "$formal_path" --arg hourly "$hourly_path" \
    --arg before_formal "sha256:$(sha "$before_formal")" --arg before_hourly "sha256:$(sha "$before_hourly")" \
    --arg candidate_formal "sha256:$(sha "$candidate_formal")" --arg candidate_hourly "sha256:$(sha "$candidate_hourly")" '
    .schema == "polyedge.parity_env_transaction.v1" and
    (.phase | test("^(prepared|formal_moved|committed|recovering|formal_restored|recovered_before)$")) and
    .formal == {path:$formal,beforeSha256:$before_formal,candidateSha256:$candidate_formal} and
    .hourly == {path:$hourly,beforeSha256:$before_hourly,candidateSha256:$candidate_hourly}
  ' "$marker" >/dev/null
}

restore_before_pair() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7 formal_restore hourly_restore
  formal_restore=$(/usr/bin/mktemp "${formal_path}.XXXXXX") || return 1
  hourly_restore=$(/usr/bin/mktemp "${hourly_path}.XXXXXX") || { /usr/bin/rm -f "$formal_restore"; return 1; }
  /usr/bin/install -o "$transaction_uid" -g "$transaction_gid" -m 0640 "$before_formal" "$formal_restore" &&
    /usr/bin/install -o "$transaction_uid" -g "$transaction_gid" -m 0600 "$before_hourly" "$hourly_restore" &&
    /usr/bin/sync -f "$formal_restore" && /usr/bin/sync -f "$hourly_restore" &&
    write_env_transaction "$marker" recovering "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" &&
    /usr/bin/mv -f "$formal_restore" "$formal_path" &&
    write_env_transaction "$marker" formal_restored "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" &&
    /usr/bin/mv -f "$hourly_restore" "$hourly_path" &&
    write_env_transaction "$marker" recovered_before "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
}

recover_env_transaction() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7 prefer=$8 formal_sha hourly_sha before_formal_sha before_hourly_sha candidate_formal_sha candidate_hourly_sha
  test -e "$marker" || return 0
  validate_env_transaction "$marker" "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" || return 1
  formal_sha="sha256:$(sha "$formal_path")"
  hourly_sha="sha256:$(sha "$hourly_path")"
  before_formal_sha="sha256:$(sha "$before_formal")"
  before_hourly_sha="sha256:$(sha "$before_hourly")"
  candidate_formal_sha="sha256:$(sha "$candidate_formal")"
  candidate_hourly_sha="sha256:$(sha "$candidate_hourly")"
  if test "$formal_sha" = "$before_formal_sha" && test "$hourly_sha" = "$before_hourly_sha"; then
    write_env_transaction "$marker" recovered_before "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
  elif test "$formal_sha" = "$candidate_formal_sha" && test "$hourly_sha" = "$candidate_hourly_sha"; then
    if test "$prefer" = before; then
      restore_before_pair "$marker" "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
    else
      write_env_transaction "$marker" committed "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
    fi
  elif { test "$formal_sha" = "$candidate_formal_sha" && test "$hourly_sha" = "$before_hourly_sha"; } ||
       { test "$formal_sha" = "$before_formal_sha" && test "$hourly_sha" = "$candidate_hourly_sha"; }; then
    restore_before_pair "$marker" "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
  else
    return 1
  fi
}

commit_candidate_pair() {
  local marker=$1 formal_path=$2 hourly_path=$3 before_formal=$4 before_hourly=$5 candidate_formal=$6 candidate_hourly=$7 formal_source=$8 hourly_source=$9
  write_env_transaction "$marker" prepared "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" &&
    /usr/bin/mv -f "$formal_source" "$formal_path" &&
    write_env_transaction "$marker" formal_moved "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly" || return 1
  if test "${POLYEDGE_TEST_KILL_BETWEEN_ENV_MOVES:-0}" = 1; then /usr/bin/kill -KILL "${BASHPID:-$$}"; fi
  /usr/bin/mv -f "$hourly_source" "$hourly_path" &&
    write_env_transaction "$marker" committed "$formal_path" "$hourly_path" "$before_formal" "$before_hourly" "$candidate_formal" "$candidate_hourly"
}

validate_first_hour_evidence() {
  local evidence_path=${1:-$evidence}
  local funded_user="$POLYEDGE_PARITY_FUNDED_UID:$POLYEDGE_PARITY_FUNDED_GID"
  local signer_invocation signer_container producer_invocation producer_container
  signer_invocation=$(/usr/bin/jq -er '.runtime.signer.invocationId' "$POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT")
  signer_container=$(/usr/bin/jq -er '.runtime.signer.containerId' "$POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT")
  producer_invocation=$(/usr/bin/jq -er '.runtime.producer.invocationId' "$POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT")
  producer_container=$(/usr/bin/jq -er '.runtime.producer.containerId' "$POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT")
  /usr/bin/jq -e --arg window "$window" --arg ledger "$ledger" \
    --arg revision "$POLYEDGE_PARITY_EXPECTED_FUNDED_REVISION" \
    --arg rollout "$POLYEDGE_PARITY_FUNDED_ROLLOUT_RECEIPT" \
    --arg rollout_sha "$POLYEDGE_PARITY_EXPECTED_FUNDED_ROLLOUT_RECEIPT_SHA256" \
    --arg namespace "$namespace" --arg queue "$queue" \
    --arg collector "$collector_sha" --arg validator "$validator_sha" \
    --arg funded_image "$POLYEDGE_PARITY_EXPECTED_FUNDED_IMAGE" --arg funded_user "$funded_user" \
    --arg funded_session "$POLYEDGE_PARITY_EXPECTED_FUNDED_SESSION_ID" \
    --arg funded_session_sha "$POLYEDGE_PARITY_EXPECTED_FUNDED_SESSION_SHA256" \
    --arg funded_config_sha "$POLYEDGE_PARITY_EXPECTED_FUNDED_CONFIG_SHA256" \
    --arg producer_image "$POLYEDGE_PARITY_EXPECTED_FUNDED_PRODUCER_IMAGE" --arg producer_user "984:980" \
    --arg producer_config_sha "$POLYEDGE_PARITY_EXPECTED_FUNDED_PRODUCER_CONFIG_SHA256" \
    --arg producer_env_sha "$producer_env_binding_sha" --arg producer_mount_sha "$producer_mount_binding_sha" \
    --arg signer_invocation "$signer_invocation" --arg signer_container "$signer_container" \
    --arg producer_invocation "$producer_invocation" --arg producer_container "$producer_container" \
    --argjson dlq "$POLYEDGE_PARITY_EXPECTED_FUNDED_SERVICE_BUS_DLQ" '
    .schemaVersion == 1 and .status == "validated" and .acceptedForParityWindow == true and
    .hourStartUtc == $window and .ledgerPath == $ledger and
    .services.fundedSignerEnabled == true and .services.fundedSignerMode == "active" and
    .services.fundedSignerRevision == $revision and
    .services.fundedRolloutReceipt == {path:$rollout,sha256:$rollout_sha} and
    .services.fundedSignerImage == $funded_image and .services.fundedSignerUser == $funded_user and
    .services.fundedSessionId == $funded_session and
    .services.fundedSessionManifestSha256 == $funded_session_sha and
    .services.fundedConfigSha256 == $funded_config_sha and
    .services.fundedIntentProducerEnabled == true and
    .services.fundedIntentProducerImage == $producer_image and
    .services.fundedIntentProducerUser == $producer_user and
    .services.fundedIntentProducerConfigSha256 == $producer_config_sha and
    .services.fundedIntentProducerRuntime.configEnvBindingSha256 == $producer_env_sha and
    .services.fundedIntentProducerRuntime.tokenMountBindingSha256 == $producer_mount_sha and
    .services.fundedServiceBusDlqBaseline == $dlq and
    .services.parityCollectorSha256 == $collector and .services.rebootValidatorSha256 == $validator and
    .services.fundedServiceBusRuntime == {namespace:$namespace,queue:$queue,status:"Active",
      activeMessageCount:0,scheduledMessageCount:0,deadLetterMessageCount:$dlq,expectedDeadLetterMessageCount:$dlq} and
    .services.fundedRuntime.invocationId == $signer_invocation and
    .services.fundedRuntime.containerId == $signer_container and
    .services.fundedRuntime.heartbeatCount >= 50 and .services.fundedRuntime.alertCount == 0 and
    .services.fundedRuntime.failedClosedCount == 0 and .services.fundedRuntime.failedAttempts == 0 and
    .services.fundedRuntime.marketWarmedCount >= 1 and .services.fundedRuntime.processedMessagesDelta > 0 and
    .services.fundedRuntime.restartCount == 0 and
    .services.fundedIntentProducerRuntime.invocationId == $producer_invocation and
    .services.fundedIntentProducerRuntime.containerId == $producer_container and
    .services.fundedIntentProducerRuntime.continuity.restartCount == 0 and
    .sameInput.deterministicResultExactMatch == true and
    .azureAuthoritative == true and .azureDeletionAllowed == false
  ' "$evidence_path" >/dev/null
}
if [ "${POLYEDGE_TEST_SOURCE_ONLY:-}" = 1 ]; then return 0; fi

restore_bindings() {
  local rc=$?
  trap - EXIT HUP INT TERM
  /usr/bin/rm -f "$formal_tmp" "$hourly_tmp" "$receipt_tmp"
  if [ "$complete" != true ] && [ "$mutations_started" = true ]; then
    /usr/bin/systemctl disable --now polyedge-parity-hourly.timer >/dev/null 2>&1 || true
    if [ -f "$transaction" ] && [ -f "$rollback/parity-hourly.env.candidate" ] && [ -f "$rollback/hourly.env.candidate" ]; then
      restore_before_pair "$transaction" "$formal" "$hourly" "$rollback/parity-hourly.env.before" \
        "$rollback/hourly.env.before" "$rollback/parity-hourly.env.candidate" "$rollback/hourly.env.candidate" || true
    fi
    /usr/bin/logger -p daemon.err -t polyedge-parity-activation "first-hour validation failed closed rc=$rc; previous bindings restored"
  fi
  exit "$rc"
}
trap restore_bindings EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

test "$(/usr/bin/id -u)" -eq 0
exec 9>/run/polyedge/utility.lock
/usr/bin/flock -n 9 || { echo 'another PolyEdge utility is active' >&2; exit 75; }

