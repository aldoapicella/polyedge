#!/bin/sh
set -eu

job=${1:?usage: polyedge-run-job JOB}

if [ "$job" = hourly ]; then
  POLYEDGE_AUDIT_TARGET=${POLYEDGE_AUDIT_TARGET:-$(date -u -d '1 hour ago' +%Y/%m/%d/%H)}
  printf '%s' "$POLYEDGE_AUDIT_TARGET" | grep -Eq '^[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9]{2}$' \
    || { echo 'POLYEDGE_AUDIT_TARGET is malformed' >&2; exit 64; }
  [ "$(date -u -d "${POLYEDGE_AUDIT_TARGET%/*} ${POLYEDGE_AUDIT_TARGET##*/}:00:00Z" +%Y/%m/%d/%H)" = "$POLYEDGE_AUDIT_TARGET" ] \
    || { echo 'POLYEDGE_AUDIT_TARGET is not canonical UTC' >&2; exit 64; }
  export POLYEDGE_AUDIT_TARGET
fi

case "$job:${POLYEDGE_UTILITY_LOCKED:-0}" in
  freshness:0|hourly:0)
    exec /usr/bin/flock -w 3600 /run/polyedge/utility.lock \
      /usr/bin/env POLYEDGE_UTILITY_LOCKED=1 "$0" "$job"
    ;;
esac

# This is intentionally separate from Azure-backed research jobs: it receives no
# credentials or mounts, and must prove this OCI host is the expected CO origin.
if [ "$job" = origin-check ]; then
  : "${POLYEDGE_VENUE_IMAGE:?set an immutable POLYEDGE_VENUE_IMAGE in /etc/polyedge/jobs/origin-check.env}"
  : "${POLYEDGE_ORIGIN_EXPECTED_IP:?set POLYEDGE_ORIGIN_EXPECTED_IP in /etc/polyedge/jobs/origin-check.env}"
  test "${POLYEDGE_ORIGIN_EXPECTED_COUNTRY:-}" = CO || {
    echo 'POLYEDGE_ORIGIN_EXPECTED_COUNTRY must equal CO' >&2
    exit 64
  }
  printf '%s' "$POLYEDGE_VENUE_IMAGE" | grep -Eq '@sha256:[0-9a-f]{64}$' || {
    echo 'POLYEDGE_VENUE_IMAGE must be an immutable sha256 digest' >&2
    exit 64
  }
  printf '%s' "$POLYEDGE_ORIGIN_EXPECTED_IP" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || {
    echo 'POLYEDGE_ORIGIN_EXPECTED_IP must be an IPv4 address' >&2
    exit 64
  }
  endpoint_ip=$(getent ahostsv4 polymarket.com | awk 'NR == 1 {print $1}')
  printf '%s' "$endpoint_ip" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || {
    echo 'could not resolve polymarket.com to IPv4' >&2
    exit 1
  }
  exec /usr/bin/timeout --preserve-status 60 \
    /usr/bin/podman run --rm --pull=never --log-driver=journald --name polyedge-job-origin-check --network polyedge \
      --add-host "polymarket.com:$endpoint_ip" --read-only --cap-drop=all --pids-limit 128 \
      --cpus 0.25 --memory 512m \
      -e POLYEDGE_ORIGIN_EXPECTED_IP -e POLYEDGE_ORIGIN_EXPECTED_COUNTRY \
      "$POLYEDGE_VENUE_IMAGE" node -e '
        const expectedIp = process.env.POLYEDGE_ORIGIN_EXPECTED_IP;
        fetch("https://polymarket.com/api/geoblock")
          .then((response) => response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`)))
          .then((origin) => {
            if (origin.country !== "CO" || origin.ip !== expectedIp) throw new Error(`unexpected origin: ${JSON.stringify(origin)}`);
            console.log(JSON.stringify(origin));
          })
          .catch((error) => { console.error(error.message); process.exit(1); });
      '
fi

case "$job" in
  freshness)
    cpus=0.5 memory=1g limit=300
    command='/bin/sh /app/research/run_compact_report_job.sh polyedge_data_freshness data_quality/freshness/latest.json polyedge-rs research azure-freshness --account "$AZURE_STORAGE_ACCOUNT_NAME" --container "$AZURE_STORAGE_CONTAINER_NAME" --prefix "${POLYEDGE_RAW_EVENT_PREFIX%/}/" --max-age-seconds 900 --expected-interval-seconds 600 --out "data_quality/freshness/latest.json"'
    ;;
  hourly)
    cpus=0.5 memory=1g limit=1800
    audit_target=$POLYEDGE_AUDIT_TARGET
    audit_day=${audit_target%/*}
    audit_hour=${audit_target##*/}
    command='OUT="reports/research/hourly/$POLYEDGE_AUDIT_DAY/$POLYEDGE_AUDIT_HOUR/audit.json"; /bin/sh /app/research/run_compact_report_job.sh polyedge_hourly_quality "$OUT" polyedge-rs research audit --input "${POLYEDGE_LOCAL_RAW_ROOT%/}/$POLYEDGE_AUDIT_DAY/$POLYEDGE_AUDIT_HOUR/" --out "$OUT" --markdown "reports/research/hourly/$POLYEDGE_AUDIT_DAY/$POLYEDGE_AUDIT_HOUR/audit.md" --exclude-file "data_quality/exclusion_windows.yaml"'
    ;;
  daily)
    cpus=1.5 memory=4g limit=46800
    command='polyedge-rs research with-azure-lease --account "$AZURE_STORAGE_ACCOUNT_NAME" --container "$AZURE_STORAGE_CONTAINER_NAME" --blob "data/research/normalized/v1/control/daily-replay.lock" --wait-seconds 28800 -- /bin/sh /app/research/run_primary_daily.sh'
    ;;
  replay)
    cpus=1.5 memory=4g limit=43200
    command='polyedge-rs research with-azure-lease --account "$AZURE_STORAGE_ACCOUNT_NAME" --container "$AZURE_STORAGE_CONTAINER_NAME" --blob "data/research/normalized/v1/control/daily-replay.lock" --wait-seconds 28800 -- /bin/sh /app/research/run_replay_index.sh'
    ;;
  prospective)
    cpus=0.5 memory=1g limit=1800
    command='polyedge-rs research validate-prospective --since "2026-07-13T00:00:00Z" --candidates "research/configs/frozen_candidates.yaml" --reports-dir "reports/research/daily" --out "reports/research/prospective/prospective_validation.json" --markdown "reports/research/prospective/prospective_validation.md"'
    ;;
  chart-backfill)
    cpus=0.5 memory=1g limit=7200
    command='INPUT=${CHART_BACKFILL_INPUT:-}; if [ -z "$INPUT" ]; then DATE=$(date -u -d "yesterday" +%Y-%m-%d); INPUT="data/research/daily/$DATE/normalized"; fi; polyedge-rs research chart-backfill --input "$INPUT" --exclude-file "data_quality/exclusion_windows.yaml" --out "reports/jobs/latest/chart-backfill.json" --markdown "reports/jobs/latest/chart-backfill.md"'
    ;;
  backfill)
    cpus=0.5 memory=1g limit=10800
    command='START=${BACKFILL_START:-2026-06-14}; END=${BACKFILL_END:-$START}; TASK=${BACKFILL_TASK:-all}; polyedge-rs research backfill --start "$START" --end "$END" --task "$TASK" --exclude-file "data_quality/exclusion_windows.yaml" --out "reports/research/backfill/$START-$END-$TASK.json" --markdown "reports/research/backfill/$START-$END-$TASK.md"'
    ;;
  shadow-qset)
    cpus=1.5 memory=8g limit=16800
    test "${SHADOW_CAMPAIGN_ID:-}" = campaign-2026-07-28-qset-v1 || {
      echo 'shadow-qset only permits campaign-2026-07-28-qset-v1' >&2
      exit 64
    }
    command='polyedge-rs research with-azure-lease --account "$AZURE_STORAGE_ACCOUNT_NAME" --container "$AZURE_STORAGE_CONTAINER_NAME" --blob "data/research/shadow/campaign-2026-07-28-qset-v1/control/replay.lock" -- /bin/sh /app/research/run_shadow_daily.sh'
    ;;
  *)
    echo "unknown PolyEdge job: $job" >&2
    exit 64
    ;;
esac

: "${POLYEDGE_RESEARCH_IMAGE:?set an immutable POLYEDGE_RESEARCH_IMAGE in /etc/polyedge/jobs/$job.env}"
printf '%s' "$POLYEDGE_RESEARCH_IMAGE" | grep -Eq '@sha256:[0-9a-f]{64}$' || {
  echo 'POLYEDGE_RESEARCH_IMAGE must be an immutable sha256 digest' >&2
  exit 64
}

if [ "$job" = daily ]; then
  daily_image=$POLYEDGE_RESEARCH_IMAGE
  parity_env=${POLYEDGE_PARITY_ENV_FILE:-/etc/polyedge/parity-hourly.env}
  [ ! -L "$parity_env" ] && [ -f "$parity_env" ] && [ "$(stat -c %h "$parity_env")" = 1 ] || {
    echo 'daily parity environment is unsafe or missing' >&2
    exit 64
  }
  set -- $(stat -c '%u %g %a' "$parity_env")
  [ "$1" = "${POLYEDGE_PARITY_EXPECTED_UID:-0}" ] \
    && [ "$2" = "${POLYEDGE_PARITY_EXPECTED_GID:-0}" ] \
    && [ "$3" = 640 ] || {
      echo 'daily parity environment has wrong owner or mode' >&2
      exit 64
    }
  set -a
  . "$parity_env"
  set +a
  POLYEDGE_RESEARCH_IMAGE=$daily_image
  POLYEDGE_PARITY_BINDINGS_FROZEN=1
  export POLYEDGE_RESEARCH_IMAGE POLYEDGE_PARITY_BINDINGS_FROZEN
fi

if [ "$job" != shadow-qset ]; then
  test "${POLYEDGE_DISABLE_RESEARCH_ARTIFACT_PUBLISH:-}" = true || {
    echo 'POLYEDGE_DISABLE_RESEARCH_ARTIFACT_PUBLISH must equal true for primary OCI jobs' >&2
    exit 64
  }
fi

if [ "$job" = freshness ]; then
  : "${POLYEDGE_RAW_EVENT_PREFIX:?set POLYEDGE_RAW_EVENT_PREFIX for Azure upload freshness}"
fi

ring=/srv/polyedge-ring
mountpoint -q "$ring" || { echo "$ring is not a mount point" >&2; exit 1; }
minimum_free=${POLYEDGE_JOB_MIN_FREE_BYTES:-42949672960}
available=$(df -P -B1 "$ring" | awk 'NR == 2 {print $4}')
[ "$available" -ge "$minimum_free" ] || {
  echo "insufficient free ring space: $available bytes available, $minimum_free required" >&2
  exit 1
}
case "$job" in
  shadow-qset) work=$ring/jobs/shadow-qset credential=shadow-qset ;;
  *) work=$ring/jobs/research credential=research ;;
esac
install -d -m 0750 "$work/data" "$work/reports" "$work/freshness"

credential_dir=/run/polyedge-federated-$credential
if [ ! -r "$credential_dir/azure-federated-token" ]; then
  # Preserve the reviewed client-secret-file rollback path.
  credential_dir=/etc/polyedge/credentials/$credential
fi

case "$job" in
  daily)
    : "${POLYEDGE_LOCAL_RAW_ROOT:?set POLYEDGE_LOCAL_RAW_ROOT to /input/events}"
    test "$POLYEDGE_LOCAL_RAW_ROOT" = /input/events || {
      echo 'POLYEDGE_LOCAL_RAW_ROOT must equal /input/events' >&2
      exit 64
    }
    POLYEDGE_RESEARCH_DATE=${POLYEDGE_RESEARCH_DATE:-$(date -u -d yesterday +%Y-%m-%d)}
    printf '%s' "$POLYEDGE_RESEARCH_DATE" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || {
      echo 'POLYEDGE_RESEARCH_DATE must be a canonical YYYY-MM-DD date' >&2
      exit 64
    }
    research_date_epoch=$(date -u -d "$POLYEDGE_RESEARCH_DATE 00:00:00Z" +%s) || {
      echo 'POLYEDGE_RESEARCH_DATE is invalid' >&2
      exit 64
    }
    test "$(date -u -d "@$research_date_epoch" +%Y-%m-%d)" = "$POLYEDGE_RESEARCH_DATE" || {
      echo 'POLYEDGE_RESEARCH_DATE must be a canonical YYYY-MM-DD date' >&2
      exit 64
    }
    export POLYEDGE_RESEARCH_DATE
    set -- --volume "$ring/segments:/input/events:ro,Z" --env POLYEDGE_RESEARCH_DATE
    ;;
  hourly)
    : "${POLYEDGE_LOCAL_RAW_ROOT:?set POLYEDGE_LOCAL_RAW_ROOT to /input/events}"
    test "$POLYEDGE_LOCAL_RAW_ROOT" = /input/events || {
      echo 'POLYEDGE_LOCAL_RAW_ROOT must equal /input/events' >&2
      exit 64
    }
    POLYEDGE_GENERATOR_EXECUTION_ID=$(cat /proc/sys/kernel/random/uuid)
    POLYEDGE_GENERATOR_PLATFORM=oci_podman
    POLYEDGE_GENERATOR_IMAGE=$POLYEDGE_RESEARCH_IMAGE
    POLYEDGE_AUDIT_DAY=$audit_day
    POLYEDGE_AUDIT_HOUR=$audit_hour
    export POLYEDGE_GENERATOR_EXECUTION_ID POLYEDGE_GENERATOR_PLATFORM POLYEDGE_GENERATOR_IMAGE POLYEDGE_AUDIT_DAY POLYEDGE_AUDIT_HOUR
    set -- --volume "$ring/segments:/input/events:ro,Z" \
      --env POLYEDGE_GENERATOR_EXECUTION_ID --env POLYEDGE_GENERATOR_PLATFORM --env POLYEDGE_GENERATOR_IMAGE \
      --env POLYEDGE_AUDIT_DAY --env POLYEDGE_AUDIT_HOUR
    ;;
  replay)
    : "${POLYEDGE_LOCAL_RAW_ROOT:?set POLYEDGE_LOCAL_RAW_ROOT to /input/events}"
    test "$POLYEDGE_LOCAL_RAW_ROOT" = /input/events || {
      echo 'POLYEDGE_LOCAL_RAW_ROOT must equal /input/events' >&2
      exit 64
    }
    set -- --volume "$ring/segments:/input/events:ro,Z"
    ;;
  *) set -- ;;
esac

# Freshness and hourly audits write only their own disjoint report paths and
# must stay live while the longer data-producing jobs serialize below.
container_name=polyedge-job-$job
remove_after=--rm
if [ "$job" = hourly ]; then
  container_name="polyedge-job-hourly-$POLYEDGE_GENERATOR_EXECUTION_ID"
  remove_after=
fi
set -- /usr/bin/timeout --preserve-status "$limit" \
  /usr/bin/podman run $remove_after --pull=never --log-driver=journald --name "$container_name" --network polyedge \
    --cpus "$cpus" --memory "$memory" --pids-limit 1024 \
    --env-file "/etc/polyedge/jobs/$job.env" \
    -v "$credential_dir:/run/credentials:ro,Z" \
    -v "$work/data:/app/data:Z" \
    -v "$work/reports:/app/reports:Z" \
    -v "$work/freshness:/app/data_quality/freshness:Z" \
    "$@" \
    "$POLYEDGE_RESEARCH_IMAGE" /bin/sh -lc "$command"

if [ "$job" = hourly ]; then
  attestation_tmp=
  published_attestation=
  trap 'rm -f "${attestation_tmp:-}" "${published_attestation:-}"; /usr/bin/podman rm -f "$container_name" >/dev/null 2>&1 || true' EXIT HUP INT TERM
  set +e
  "$@"
  status=$?
  set -e
  [ "$status" -eq 0 ] || exit "$status"

  report=$work/reports/research/hourly/$audit_day/$audit_hour/audit.json
  attestation=$report.attestation.json
  [ ! -L "$report" ] && [ -f "$report" ] && [ "$(stat -c %h "$report")" = 1 ] || {
    echo "hourly audit report is missing or unsafe: $report" >&2
    exit 1
  }
  configured_image=$(/usr/bin/podman inspect --format '{{.Config.Image}}' "$container_name")
  image_digest=$(/usr/bin/podman inspect --format '{{.ImageDigest}}' "$container_name")
  container_id=$(/usr/bin/podman inspect --format '{{.Id}}' "$container_name")
  [ "$configured_image" = "$POLYEDGE_RESEARCH_IMAGE" ] || { echo 'hourly container image differs from configured immutable image' >&2; exit 1; }
  printf '%s' "$image_digest" | grep -Eq '^sha256:[0-9a-f]{64}$' || { echo 'hourly container image digest is invalid' >&2; exit 1; }
  printf '%s' "$container_id" | grep -Eq '^[0-9a-f]{64}$' || { echo 'hourly container ID is invalid' >&2; exit 1; }
  jq -e --arg image "$configured_image" --arg execution "$POLYEDGE_GENERATOR_EXECUTION_ID" '
    .generator_provenance == {
      schema_version:1,platform:"oci_podman",image:$image,execution_id:$execution,job_name:null
    }
  ' "$report" >/dev/null || { echo 'hourly report generator provenance is invalid' >&2; exit 1; }

  attestation_tmp=$(mktemp "$attestation.XXXXXX")
  jq -n --arg report_sha256 "sha256:$(sha256sum "$report" | awk '{print $1}')" \
    --arg image "$configured_image" --arg image_digest "$image_digest" \
    --arg execution "$POLYEDGE_GENERATOR_EXECUTION_ID" --arg container_id "$container_id" \
    '{schema_version:1,report_sha256:$report_sha256,platform:"oci_podman",image:$image,
      image_digest:$image_digest,execution_id:$execution,container_id:$container_id}' >"$attestation_tmp"
  chmod 0640 "$attestation_tmp"
  chown 0:0 "$attestation_tmp"
  sync -f "$attestation_tmp"
  mv "$attestation_tmp" "$attestation"
  attestation_tmp=
  published_attestation=$attestation
  [ ! -L "$attestation" ] && [ -f "$attestation" ] && [ "$(stat -c '%u:%g:%a:%h' "$attestation")" = '0:0:640:1' ] || {
    echo 'hourly audit attestation is unsafe' >&2
    exit 1
  }
  jq -e --arg report_sha256 "sha256:$(sha256sum "$report" | awk '{print $1}')" \
    --arg image "$configured_image" --arg image_digest "$image_digest" \
    --arg execution "$POLYEDGE_GENERATOR_EXECUTION_ID" --arg container_id "$container_id" '
    . == {schema_version:1,report_sha256:$report_sha256,platform:"oci_podman",image:$image,
      image_digest:$image_digest,execution_id:$execution,container_id:$container_id}
  ' "$attestation" >/dev/null || {
    echo 'hourly audit attestation failed post-write validation' >&2
    exit 1
  }
  /usr/bin/podman rm "$container_name" >/dev/null
  published_attestation=
  trap - EXIT HUP INT TERM
  exit 0
fi

case "$job" in
  daily|replay|prospective|chart-backfill|backfill|shadow-qset)
    set -- /usr/bin/flock -w 129600 /run/polyedge/research.lock "$@"
    ;;
esac
if [ "$job" = daily ]; then
  "$@"
  exec /usr/local/libexec/polyedge-parity-record-daily "$POLYEDGE_RESEARCH_DATE"
fi
exec "$@"
