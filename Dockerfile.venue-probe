FROM node:22-bookworm-slim

ARG GIT_SHA
LABEL org.opencontainers.image.revision=${GIT_SHA}

WORKDIR /app

COPY venue-probe/package.json venue-probe/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY --chown=node:node venue-probe/src ./src

USER node

CMD ["node", "src/probe.mjs"]
